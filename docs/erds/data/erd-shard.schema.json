{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ERD data shards",
  "description": "Schemas for the files in docs/erds/data/. Checked by scripts/erd/erd_shards.py (a dependency-free subset validator).",
  "definitions": {
    "domain": {
      "type": "object",
      "required": ["provenance", "objects"],
      "additionalProperties": false,
      "properties": {
        "provenance": {
          "type": "object",
          "required": ["release", "apiVersion", "verifiedOn", "method", "coreSourceValidated"],
          "additionalProperties": false,
          "properties": {
            "release": {"type": "string", "pattern": "^[0-9]+$"},
            "apiVersion": {"type": "string", "pattern": "^[0-9]+\\.0$"},
            "verifiedOn": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
            "method": {"type": "string"},
            "coreSourceValidated": {"type": "boolean"}
          }
        },
        "objects": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["domain", "domainShort", "fields"],
            "properties": {
              "domain": {"type": "string"},
              "domainShort": {"type": "string"},
              "fields": {"type": "object", "additionalProperties": {"type": "object"}}
            }
          }
        }
      }
    },
    "meta": {
      "type": "object",
      "required": ["metadata", "objectOrder"],
      "additionalProperties": false,
      "properties": {
        "metadata": {"type": "object", "required": ["release", "apiVersion", "lastRefreshedOn"]},
        "objectOrder": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "relationships": {
      "type": "object",
      "required": ["relationships"],
      "additionalProperties": false,
      "properties": {
        "relationships": {
          "type": "array",
          "items": {"type": "object", "required": ["source", "target"]}
        }
      }
    }
  }
}
