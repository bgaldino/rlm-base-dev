# Project env for rlm-base-dev. Activated by direnv on entry; deactivated on exit.
# Requires: brew install direnv ; eval "$(direnv hook zsh)" in ~/.zshrc.

# ── Python via pyenv ─────────────────────────────────────────────────────────
# Pin to the 3.13 major.minor line; auto-resolve to the latest installed patch.
# To install a new 3.13.x patch, run `scripts/bash/update-toolchain.sh` — it
# resolves the latest patch in the line, installs it, and reinstalls the CCI
# pipx venv under the new Python (the venv's python symlink breaks otherwise).
# Manual equivalent: `pyenv install $(pyenv latest -k 3.13)`.
# The patch is found by listing pyenv's versions dir, not with `pyenv latest 3.13` and
# `pyenv root`: those two cost about a quarter of a second, and this file runs in every
# shell started in the repo. Only plain 3.13.N names count, so a prerelease (3.13.0rc1)
# or free-threaded (3.13.5t) build is never picked.
if command -v pyenv >/dev/null 2>&1; then
  _PY_LINE=3.13 _PY_ROOT="${PYENV_ROOT:-$HOME/.pyenv}" _PY_RESOLVED="" _PY_BEST=-1
  for _PY_BIN in "$_PY_ROOT"/versions/"$_PY_LINE".*/bin/python3; do
    _PY_N="${_PY_BIN%/bin/python3}" && _PY_N="${_PY_N##*/"$_PY_LINE".}"
    case "$_PY_N" in ''|*[!0-9]*) continue ;; esac
    if [ -x "$_PY_BIN" ] && [ "$_PY_N" -gt "$_PY_BEST" ]; then
      _PY_BEST="$_PY_N" _PY_RESOLVED="$_PY_LINE.$_PY_N"
    fi
  done
  if [ -n "$_PY_RESOLVED" ]; then
    export PYENV_VERSION="$_PY_RESOLVED"
    PATH_add "$_PY_ROOT/shims"
  else
    echo ".envrc: no Python $_PY_LINE.x installed via pyenv. Run scripts/bash/update-toolchain.sh or 'pyenv install \$(pyenv latest -k $_PY_LINE)' to install the latest patch." >&2
  fi
  unset _PY_LINE _PY_ROOT _PY_RESOLVED _PY_BEST _PY_BIN _PY_N
fi

# ── Node via nvm ─────────────────────────────────────────────────────────────
# `.nvmrc` pins the repo's Node major line, the same line as the Dockerfile's
# NODE_MAJOR, CI's setup-node and package.json's engines (a check in
# tests/test_node_line.py keeps them in step). Don't float on `lts/*`: it jumps to
# a new major the day that major becomes LTS.
#
# The newest installed patch of that major is the one a bare `nvm use` would pick,
# but it's found by listing $NVM_DIR/versions/node: loading nvm and running `nvm use`
# cost about half a second, and this file runs in every shell started in the repo.
# It goes first on PATH, and every other nvm Node dir leaves PATH (the shell's
# `default` from ~/.zshenv among them; a package's bin dir under a version stays), so
# PATH holds one Node. That's stricter than `nvm use`, which edits the old nvm entry
# in place and can leave another Node ahead of it. NVM_BIN and NVM_INC are set as
# `nvm use` sets them; MANPATH isn't touched. Should .nvmrc ever hold something other
# than a bare major (the same check stops that), nvm is loaded and `nvm use` reads it.
# nvm.sh is found the way scripts/bash/update-toolchain.sh step 3 finds it (a check
# in tests/test_node_line.py keeps the two in step): Homebrew's first, via
# `brew --prefix nvm` (Apple Silicon's `/opt/homebrew` or Intel's `/usr/local`);
# else nvm's own installer's, which puts nvm.sh in $NVM_DIR ($XDG_CONFIG_HOME/nvm
# when that variable was set at install time).
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
_NVM_SH=""
_NVM_PREFIX="$(brew --prefix nvm 2>/dev/null || true)"
if [ -n "$_NVM_PREFIX" ] && [ -s "$_NVM_PREFIX/nvm.sh" ]; then
  _NVM_SH="$_NVM_PREFIX/nvm.sh"
elif [ -s "$NVM_DIR/nvm.sh" ]; then
  _NVM_SH="$NVM_DIR/nvm.sh"
elif [ -n "${XDG_CONFIG_HOME:-}" ] && [ -s "$XDG_CONFIG_HOME/nvm/nvm.sh" ]; then
  export NVM_DIR="$XDG_CONFIG_HOME/nvm"
  _NVM_SH="$NVM_DIR/nvm.sh"
fi
if [ -n "$_NVM_SH" ]; then
  _NODE_RC=""
  [ -r .nvmrc ] && { read -r _NODE_RC < .nvmrc || true; }
  _NODE_LINE="${_NODE_RC%%[[:space:]]*}" && _NODE_LINE="${_NODE_LINE#v}"
  case "$_NODE_LINE" in ''|*[!0-9]*) _NODE_LINE="" ;; esac
  # No fallback to nvm's `default`: that can be an older line, and selecting it silently
  # hides the problem. Say so instead; validate_setup also fails a lower major.
  _NODE_MISSING=".envrc: Node $_NODE_RC (from .nvmrc) isn't installed. Run 'nvm install' here, or scripts/bash/update-toolchain.sh."
  if [ -n "$_NODE_LINE" ]; then
    _NODE_BIN="" _NODE_MI=-1 _NODE_PA=-1
    for _NODE_D in "$NVM_DIR"/versions/node/v"$_NODE_LINE".*/bin; do
      # Only a release's vMAJOR.MINOR.PATCH name counts, not a prerelease's.
      _NODE_V="${_NODE_D%/bin}" && _NODE_V="${_NODE_V##*/v"$_NODE_LINE".}"
      case "$_NODE_V" in [0-9]*.[0-9]*) ;; *) continue ;; esac
      case "$_NODE_V" in *[!0-9.]*|*.*.*) continue ;; esac
      [ -x "$_NODE_D/node" ] || continue
      _NODE_M="${_NODE_V%.*}" _NODE_P="${_NODE_V#*.}"
      if [ "$_NODE_M" -gt "$_NODE_MI" ] || { [ "$_NODE_M" -eq "$_NODE_MI" ] && [ "$_NODE_P" -gt "$_NODE_PA" ]; }; then
        _NODE_BIN="$_NODE_D" _NODE_MI="$_NODE_M" _NODE_PA="$_NODE_P"
      fi
    done
    if [ -n "$_NODE_BIN" ]; then
      # The rest of PATH, empty entries included, keeps its order.
      _NODE_REST="" _NODE_LEFT="$PATH:"
      while [ -n "$_NODE_LEFT" ]; do
        _NODE_D="${_NODE_LEFT%%:*}" _NODE_LEFT="${_NODE_LEFT#*:}"
        case "$_NODE_D" in
          "$NVM_DIR"/versions/node/*/*/bin) _NODE_REST="$_NODE_REST:$_NODE_D" ;;
          "$NVM_DIR"/versions/node/*/bin) ;;
          *) _NODE_REST="$_NODE_REST:$_NODE_D" ;;
        esac
      done
      export PATH="$_NODE_BIN$_NODE_REST" NVM_BIN="$_NODE_BIN" NVM_INC="${_NODE_BIN%/bin}/include/node"
    else
      echo "$_NODE_MISSING" >&2
    fi
  else
    . "$_NVM_SH" --no-use
    nvm use --silent >/dev/null 2>&1 || echo "$_NODE_MISSING" >&2
  fi
  unset _NODE_RC _NODE_LINE _NODE_MISSING _NODE_BIN _NODE_MI _NODE_PA _NODE_D _NODE_V _NODE_M _NODE_P _NODE_REST _NODE_LEFT
else
  echo ".envrc: nvm not found (via 'brew --prefix nvm', in \$NVM_DIR or in \$XDG_CONFIG_HOME/nvm), so .nvmrc's Node line isn't applied. Install it (docs/guides/local-installation.md, Step 3), or put Homebrew on PATH if your nvm comes from Homebrew." >&2
fi
unset _NVM_PREFIX _NVM_SH

# ── Per-workstation overrides ────────────────────────────────────────────────
# This file is tracked, so a machine-specific line added here is lost the next
# time git rewrites it (a checkout, merge or reset). Put those in .env.local,
# which is gitignored, e.g. the Chrome for Testing pair a managed workstation
# needs (docs/guides/local-installation.md → Chrome for Testing).
# It's read as dotenv (KEY="value", with $VAR expansion), never run as shell: direnv
# doesn't ask to approve a file loaded from here, so it must not be able to run
# code. A $(cmd) stays literal text; quote any value with spaces, because one
# unparsable line stops the whole file from loading.
dotenv_if_exists .env.local
