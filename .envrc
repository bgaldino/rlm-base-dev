# Project env for rlm-base-dev. Activated by direnv on entry; deactivated on exit.
# Requires: brew install direnv ; eval "$(direnv hook zsh)" in ~/.zshrc.

# ── Python via pyenv ─────────────────────────────────────────────────────────
# Pin to the 3.13 major.minor line; auto-resolve to the latest installed patch.
# To install a new 3.13.x patch, run `scripts/bash/update-toolchain.sh` — it
# resolves the latest patch in the line, installs it, and reinstalls the CCI
# pipx venv under the new Python (the venv's python symlink breaks otherwise).
# Manual equivalent: `pyenv install $(pyenv latest -k 3.13)`.
if command -v pyenv >/dev/null 2>&1; then
  _PY_RESOLVED="$(pyenv latest 3.13 2>/dev/null)"
  if [ -n "$_PY_RESOLVED" ]; then
    export PYENV_VERSION="$_PY_RESOLVED"
    PATH_add "$(pyenv root)/shims"
  else
    echo ".envrc: no Python 3.13.x installed via pyenv. Run scripts/bash/update-toolchain.sh or 'pyenv install \$(pyenv latest -k 3.13)' to install the latest patch." >&2
  fi
  unset _PY_RESOLVED
fi

# ── Node via nvm ─────────────────────────────────────────────────────────────
# `.nvmrc` pins the repo's Node major line, the same line as the Dockerfile's
# NODE_MAJOR, CI's setup-node and package.json's engines (a check in
# tests/test_node_line.py keeps them in step). A bare `nvm use` reads it. Don't
# float on `lts/*`: it jumps to a new major the day that major becomes LTS.
# nvm.sh is found the way scripts/bash/update-toolchain.sh step 3 finds it (a check
# in tests/test_node_line.py keeps the two in step): Homebrew's first, via
# `brew --prefix nvm` (Apple Silicon's `/opt/homebrew` or Intel's `/usr/local`);
# else nvm's own installer's, which puts nvm.sh in $NVM_DIR ($XDG_CONFIG_HOME/nvm
# when that variable was set at install time).
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
_NVM_SH=""
_NVM_PREFIX="$(brew --prefix nvm 2>/dev/null || true)"
if [ -n "$_NVM_PREFIX" ] && [ -s "$_NVM_PREFIX/nvm.sh" ]; then
  _NVM_SH="$_NVM_PREFIX/nvm.sh"
elif [ -s "$NVM_DIR/nvm.sh" ]; then
  _NVM_SH="$NVM_DIR/nvm.sh"
elif [ -n "${XDG_CONFIG_HOME:-}" ] && [ -s "$XDG_CONFIG_HOME/nvm/nvm.sh" ]; then
  export NVM_DIR="$XDG_CONFIG_HOME/nvm"
  _NVM_SH="$NVM_DIR/nvm.sh"
fi
if [ -n "$_NVM_SH" ]; then
  . "$_NVM_SH" --no-use
  # No fallback to nvm's `default`: that can be an older line, and selecting it silently
  # hides the problem. Say so instead; validate_setup also fails a lower major.
  nvm use --silent >/dev/null 2>&1 \
    || echo ".envrc: Node $(cat .nvmrc 2>/dev/null) (from .nvmrc) isn't installed. Run 'nvm install' here, or scripts/bash/update-toolchain.sh." >&2
else
  echo ".envrc: nvm not found (Homebrew's, \$NVM_DIR/nvm.sh or \$XDG_CONFIG_HOME/nvm/nvm.sh), so .nvmrc's Node line isn't applied. Install nvm: docs/guides/local-installation.md, Step 3." >&2
fi
unset _NVM_PREFIX _NVM_SH

# ── Per-workstation overrides ────────────────────────────────────────────────
# This file is tracked, so a machine-specific line added here is lost the next
# time git rewrites it (a checkout, merge or reset). Put those in .env.local,
# which is gitignored, e.g. the Chrome for Testing pair a managed workstation
# needs (docs/guides/local-installation.md → Chrome for Testing).
# It's read as dotenv (KEY="value", with $VAR expansion), never run as shell: direnv
# doesn't ask to approve a file loaded from here, so it must not be able to run
# code. A $(cmd) stays literal text; quote any value with spaces, because one
# unparsable line stops the whole file from loading.
dotenv_if_exists .env.local
