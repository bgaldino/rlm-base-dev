<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Add_BSG_Id</name>
        <label>Add BSG Id</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>bsgIds</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_BSGs.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_BSGs</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Mark_Milestone_Flag</name>
        <label>Mark Milestone Flag</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>Loop_Milestones.IsMilestoneAccomplished</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>milestonesToUpdate</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Milestones</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Milestones</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Already_Accomplished_Error</name>
        <label>Set Already Accomplished Error</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>errorMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>AlreadyAccomplishedMessage</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_BSG_Not_Found_Error</name>
        <label>Set BSG Not Found Error</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>errorMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>No active Billing Schedule Group found for this account. Please ensure the account has an active subscription with milestone billing.</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_Milestone_Name</name>
        <label>Set Milestone Name</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>milestoneName</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>MilestoneNameFormula</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Get_Billing_Schedule_Group</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Milestone_Not_Found_Error</name>
        <label>Set Milestone Not Found Error</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>errorMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>MilestoneNotFoundMessage</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_Record_Type_Error</name>
        <label>Set Record Type Error</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>errorMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>This flow can only be executed for accounts with the RLM_HomeServices_Account record type.</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>BSG_Found_Check</name>
        <label>Billing Schedule Group Found?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Set_BSG_Not_Found_Error</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Found</defaultConnectorLabel>
        <rules>
            <name>BSG_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>billingScheduleGroups</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_BSGs</targetReference>
            </connector>
            <label>Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Milestone_Found_Check</name>
        <label>Milestone Plan Item Found?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Set_Milestone_Not_Found_Error</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Found</defaultConnectorLabel>
        <rules>
            <name>Milestone_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>milestonePlanItems</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_Milestones</targetReference>
            </connector>
            <label>Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Not_Accomplished_Check</name>
        <label>Not Accomplished?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Loop_Milestones</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Already Accomplished</defaultConnectorLabel>
        <rules>
            <name>Not_Accomplished</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Milestones.IsMilestoneAccomplished</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Mark_Milestone_Flag</targetReference>
            </connector>
            <label>Not Accomplished</label>
        </rules>
    </decisions>
    <decisions>
        <name>Record_Type_Check</name>
        <label>Correct Record Type?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Set_Record_Type_Error</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Wrong Record Type</defaultConnectorLabel>
        <rules>
            <name>Is_RLM_Home_Services</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>recordType</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Milestone_Name</targetReference>
            </connector>
            <label>Is RLM_Home_Services</label>
        </rules>
    </decisions>
    <decisions>
        <name>To_Update_Check</name>
        <label>Any To Update?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Set_Already_Accomplished_Error</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>None To Update</defaultConnectorLabel>
        <rules>
            <name>Has_Records_To_Update</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>milestonesToUpdate</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Milestones</targetReference>
            </connector>
            <label>Has Records To Update</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>AlreadyAccomplishedMessage</name>
        <dataType>String</dataType>
        <expression>&quot;Month &quot; &amp; TEXT({!serviceMonth}) &amp; &quot; service has already been marked complete for this account.&quot;</expression>
    </formulas>
    <formulas>
        <name>MilestoneNameFormula</name>
        <dataType>String</dataType>
        <expression>&quot;Month &quot; &amp; TEXT({!serviceMonth}) &amp; &quot; Service&quot;</expression>
    </formulas>
    <formulas>
        <name>MilestoneNotFoundMessage</name>
        <dataType>String</dataType>
        <expression>&quot;Billing milestone plan item &apos;&quot; &amp; {!milestoneName} &amp; &quot;&apos; was not found on this account&apos;s billing schedule group.&quot;</expression>
    </formulas>
    <interviewLabel>RLM_HomeServices_FieldTechMonthlyService {!$Flow.CurrentDateTime}</interviewLabel>
    <label>RLM_HomeServices_FieldTechMonthlyService</label>
    <loops>
        <name>Loop_BSGs</name>
        <label>Loop BSGs</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>billingScheduleGroups</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Add_BSG_Id</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Get_Billing_Milestone_Plan_Item</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>Loop_Milestones</name>
        <label>Loop Milestones</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>milestonePlanItems</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Not_Accomplished_Check</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>To_Update_Check</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Account</name>
        <label>Get Account</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Account_Record_Type</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>accountId</elementReference>
            </value>
        </filters>
        <object>Account</object>
        <outputReference>account</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>RecordTypeId</queriedFields>
    </recordLookups>
    <recordLookups>
        <name>Get_Account_Record_Type</name>
        <label>Get Account Record Type</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Record_Type_Check</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>account.RecordTypeId</elementReference>
            </value>
        </filters>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>RLM_HomeServices_Account</stringValue>
            </value>
        </filters>
        <object>RecordType</object>
        <outputReference>recordType</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>DeveloperName</queriedFields>
    </recordLookups>
    <recordLookups>
        <name>Get_Billing_Milestone_Plan_Item</name>
        <label>Get Milestone Plan Items</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Milestone_Found_Check</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>BillingScheduleGroupId</field>
            <operator>In</operator>
            <value>
                <elementReference>bsgIds</elementReference>
            </value>
        </filters>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>milestoneName</elementReference>
            </value>
        </filters>
        <object>BillingMilestonePlanItem</object>
        <outputReference>milestonePlanItems</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
        <queriedFields>IsMilestoneAccomplished</queriedFields>
        <queriedFields>BillingScheduleGroupId</queriedFields>
    </recordLookups>
    <recordLookups>
        <name>Get_Billing_Schedule_Group</name>
        <label>Get Billing Schedule Groups</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>BSG_Found_Check</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>BillingAccountId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>accountId</elementReference>
            </value>
        </filters>
        <object>BillingScheduleGroup</object>
        <outputReference>billingScheduleGroups</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>BillingAccountId</queriedFields>
        <queriedFields>ProductName</queriedFields>
    </recordLookups>
    <recordUpdates>
        <name>Update_Milestones</name>
        <label>Mark Milestones Accomplished</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputReference>milestonesToUpdate</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Account</targetReference>
        </connector>
    </start>
    <status>Active</status>
