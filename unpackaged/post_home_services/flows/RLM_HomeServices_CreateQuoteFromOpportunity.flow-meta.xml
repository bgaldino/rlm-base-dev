<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <description>Only proceed when Home Services automation is enabled via the org-level custom setting.</description>
        <name>Is_Home_Services_Enabled</name>
        <label>Is Home Services Enabled?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Not Enabled</defaultConnectorLabel>
        <rules>
            <name>Yes_Enabled</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Setup.RLM_HomeServices_Settings__c.RLM_Enabled__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Initial_Quote_Subflow</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <description>Only iterate when opportunity products exist.</description>
        <name>Opportunity_Has_Line_Items</name>
        <label>Opportunity Has Line Items?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No Line Items</defaultConnectorLabel>
        <rules>
            <name>Yes_Has_Line_Items</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Opportunity_Line_Items</leftValueReference>
                <operator>IsEmpty</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Iterate_Opp_Line_Items</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <description>364 days after the quote line start date (1st of the current month) in ISO 8601 format (YYYY-MM-DD) for the PlaceQuote API.</description>
        <name>QuoteLineEndDate</name>
        <dataType>String</dataType>
        <expression>TEXT(YEAR(DATE(YEAR(TODAY()), MONTH(TODAY()), 1) + 364)) &amp; &quot;-&quot; &amp; RIGHT(&quot;0&quot; &amp; TEXT(MONTH(DATE(YEAR(TODAY()), MONTH(TODAY()), 1) + 364)), 2) &amp; &quot;-&quot; &amp; RIGHT(&quot;0&quot; &amp; TEXT(DAY(DATE(YEAR(TODAY()), MONTH(TODAY()), 1) + 364)), 2)</expression>
    </formulas>
    <formulas>
        <description>First day of the current calendar month in ISO 8601 format (YYYY-MM-DD) for the PlaceQuote API.</description>
        <name>QuoteLineStartDate</name>
        <dataType>String</dataType>
        <expression>TEXT(YEAR(TODAY())) &amp; &quot;-&quot; &amp; RIGHT(&quot;0&quot; &amp; TEXT(MONTH(TODAY())), 2) &amp; &quot;-01&quot;</expression>
    </formulas>
    <interviewLabel>RLM_HomeServices_CreateQuoteFromOpportunity {!$Flow.CurrentDateTime}</interviewLabel>
    <label>RLM_HomeServices_CreateQuoteFromOpportunity</label>
    <loops>
        <description>One add-line subflow per opportunity product.</description>
        <name>Iterate_Opp_Line_Items</name>
        <label>Iterate Opp Line Items</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Opportunity_Line_Items</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Get_Pricebook_Entry_From_Opp_Line</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Set_AccountforQuote</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Opportunity products to copy onto the new quote.</description>
        <name>Get_Opportunity_Line_Items</name>
        <label>Get Opportunity Line Items</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Opportunity_Has_Line_Items</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>OpportunityId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>OpportunityLineItem</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Product2Id</queriedFields>
        <queriedFields>PricebookEntryId</queriedFields>
        <queriedFields>Quantity</queriedFields>
        <sortField>CreatedDate</sortField>
        <sortOrder>Asc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>ProductSellingModelId for RLM add-line; must match the opportunity line PricebookEntry.</description>
        <name>Get_Pricebook_Entry_From_Opp_Line</name>
        <label>Get Pricebook Entry From Opp Line</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Add_Quote_Line_Item_Subflow</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Iterate_Opp_Line_Items.PricebookEntryId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>PricebookEntry</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>ProductSellingModelId</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Set_AccountforQuote</name>
        <label>Set AccountforQuote</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_Ship_To_Address</targetReference>
        </connector>
        <inputAssignments>
            <field>QuoteAccountId</field>
            <value>
                <elementReference>$Record.AccountId</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record.Quotes</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Ship_To_Address</name>
        <label>Update Ship To Address</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>ShippingCity</field>
            <value>
                <elementReference>$Record.Account.BillingCity</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ShippingCountry</field>
            <value>
                <elementReference>$Record.Account.BillingCountry</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ShippingPostalCode</field>
            <value>
                <elementReference>$Record.Account.BillingPostalCode</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ShippingState</field>
            <value>
                <elementReference>$Record.Account.BillingState</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ShippingStreet</field>
            <value>
                <elementReference>$Record.Account.BillingStreet</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record.Quotes</inputReference>
    </recordUpdates>
    <runInMode>DefaultMode</runInMode>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Is_Home_Services_Enabled</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>and</filterLogic>
        <filters>
            <field>StageName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>On-site Assessment</stringValue>
            </value>
        </filters>
        <object>Opportunity</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <subflows>
        <description>Packaged Revenue Quote Management — add line using graph / place transaction.</description>
        <name>Add_Quote_Line_Item_Subflow</name>
        <label>Add Quote Line Item (quotingAI)</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Iterate_Opp_Line_Items</targetReference>
        </connector>
        <flowName>quotingAI__addQuoteLineItemToQuote</flowName>
        <inputAssignments>
            <name>quoteId</name>
            <value>
                <elementReference>Create_Initial_Quote_Subflow.quoteId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>productId</name>
            <value>
                <elementReference>Iterate_Opp_Line_Items.Product2Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>quantity</name>
            <value>
                <elementReference>Iterate_Opp_Line_Items.Quantity</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>productSellingModelId</name>
            <value>
                <elementReference>Get_Pricebook_Entry_From_Opp_Line.ProductSellingModelId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>startDate</name>
            <value>
                <elementReference>QuoteLineStartDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>endDate</name>
            <value>
                <elementReference>QuoteLineEndDate</elementReference>
            </value>
        </inputAssignments>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </subflows>
    <subflows>
        <description>Packaged Revenue Quote Management — initial quote + sales transaction context.</description>
        <name>Create_Initial_Quote_Subflow</name>
        <label>Create Initial Quote on Opp (quotingAI)</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Opportunity_Line_Items</targetReference>
        </connector>
        <flowName>quotingAI__createInitialQuoteOnOpp</flowName>
        <inputAssignments>
            <name>OpportunityId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </subflows>
</Flow>
