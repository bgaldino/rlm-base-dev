<?xml version="1.0" encoding="UTF-8"?>
<!-- Permission set granting Apex class access and object/field permissions required
     by the RLM_UsageOrchestrationController and RLM_UsageUploaderController classes.
     These controllers power the rlmUsageOrchestration and rlmUsageUploader LWC components.

     RLM_UsageOrchestrationController: Starts autolaunched flows for usage orchestration.
     No DML, no SOQL — class access only.

     RLM_UsageUploaderController: Inserts TransactionJournal records (usage upload) and
     reads usage-related objects (Asset, UsageResource, ProductUsageResource, UnitOfMeasure,
     AssetRateCardEntry, RateAdjustmentByTier, TransactionUsageEntitlement,
     UsageEntitlementBucket). Controller uses Security.stripInaccessible(CREATABLE, ...) on
     TransactionJournal insert, so editable fieldPermissions below grant the nillable create
     fields. Required (non-nillable) fields are intentionally omitted — Salesforce rejects
     permset deploys that reference them, and they're accessible without explicit grants. -->
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <classAccesses>
        <apexClass>RLM_UsageOrchestrationController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>RLM_UsageUploaderController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <!-- TransactionJournal nillable create fields (controller uses Security.stripInaccessible CREATABLE) -->
    <fieldPermissions>
        <editable>true</editable>
        <field>TransactionJournal.AccountId</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>TransactionJournal.ReferenceRecordId</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>TransactionJournal.UsageResourceId</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>TransactionJournal.Quantity</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>TransactionJournal.ActivityDate</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>TransactionJournal.StartDate</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>TransactionJournal.EndDate</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>TransactionJournal.QuantityUnitOfMeasureId</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>TransactionJournal.UsageType</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>TransactionJournal.Status</field>
        <readable>true</readable>
    </fieldPermissions>
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Asset</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>UsageResource</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>ProductUsageResource</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>UnitOfMeasure</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>AssetRateCardEntry</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>RateAdjustmentByTier</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>TransactionUsageEntitlement</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>UsageEntitlementBucket</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>TransactionJournal</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <hasActivationRequired>false</hasActivationRequired>
    <label>RLM Usage Controllers</label>
    <description>Grants Apex class access to RLM_UsageOrchestrationController and RLM_UsageUploaderController, plus object/field permissions required for usage upload (TransactionJournal insert and read access to related usage objects).</description>
</PermissionSet>
