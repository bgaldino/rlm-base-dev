<?xml version="1.0" encoding="UTF-8"?>
<!-- Permission set granting Apex class access and comprehensive object/field permissions
     required by the RLM_UsageUploaderController class (rlmUsageUploader LWC component).

     Inserts TransactionJournal records (usage upload) and reads usage-related objects. Controller
     uses Security.stripInaccessible(CREATABLE, ...) for DML security hardening. WITH USER_MODE /
     AccessLevel.USER_MODE would provide additional SOQL/DML enforcement but are not available on
     Summer '26 v67.0 orgs built from this repo's scratch org definitions (feature appears to be
     preview/pilot-gated, despite existing in other v67.0 classes in this codebase).

     Field-level permissions are limited to the four permissionable, nillable TransactionJournal
     create fields below. Most queried fields across usage objects are required (per Salesforce
     platform rules, required fields cannot be granted via fieldPermissions and reject the deploy).
     Object-level READ grants provide object access; users inherit READ FLS on required fields
     automatically per platform behavior. Six TransactionJournal fields are omitted: two required
     (ActivityDate, Status) and four non-permissionable (AccountId, ReferenceRecordId,
     UsageResourceId, UsageType).

     Note: All 12 READ object grants overlap with the RLM_USG permission set group (always assigned).
     The only incremental permissions are TransactionJournal CREATE plus field-level grants. READ
     object grants are retained to make this set self-sufficient if assigned standalone (partial builds,
     manual assignment, or future PSG changes). Salesforce automatically deduplicates permissions. -->
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <classAccesses>
        <apexClass>RLM_UsageUploaderController</apexClass>
        <enabled>true</enabled>
    </classAccesses>

    <!-- TransactionJournal permissionable create fields (controller uses Security.stripInaccessible CREATABLE).
         Four fields (AccountId, ReferenceRecordId, UsageResourceId, UsageType) are non-permissionable and omitted. -->
    <fieldPermissions>
        <editable>true</editable>
        <field>TransactionJournal.Quantity</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>TransactionJournal.StartDate</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>TransactionJournal.EndDate</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>TransactionJournal.QuantityUnitOfMeasureId</field>
        <readable>true</readable>
    </fieldPermissions>

    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Account</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
