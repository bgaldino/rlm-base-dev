<?xml version="1.0" encoding="UTF-8"?>
<!-- Permission set granting Apex class access and comprehensive object/field permissions
     required by the RLM_UsageUploaderController class (rlmUsageUploader LWC component).

     Inserts TransactionJournal records (usage upload) and reads usage-related objects. All 14
     SOQL queries reachable from @AuraEnabled methods use WITH USER_MODE (live-verified on the
     july28 v67.0 scratch org: deploys clean, all Apex tests pass in-org). DML uses
     Security.stripInaccessible(CREATABLE, ...).

     Field-level permissions cover every permissionable field the USER_MODE queries select or
     filter on: TransactionJournal create fields (editable) plus Asset/Product2 read fields
     (readable only — the controller never writes them). Most other queried objects
     (ProductUsageResource, UsageResource, AssetRateCardEntry, RateCardEntry,
     RateAdjustmentByTier, TransactionUsageEntitlement, UsageEntitlementBucket) expose zero
     permissionable fields at all — object-level READ fully covers their queried fields per
     platform rules, so no fieldPermissions rows exist for them. TransactionJournal omits six
     fields: two required (ActivityDate, Status) and four non-permissionable (AccountId,
     ReferenceRecordId, UsageResourceId, UsageType).

     Note: All 12 READ object grants overlap with the RLM_USG permission set group (always assigned).
     The only incremental permissions are TransactionJournal CREATE plus field-level grants. READ
     object grants are retained to make this set self-sufficient if assigned standalone (partial builds,
     manual assignment, or future PSG changes). Salesforce automatically deduplicates permissions. -->
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <classAccesses>
        <apexClass>RLM_UsageUploaderController</apexClass>
        <enabled>true</enabled>
    </classAccesses>

    <!-- TransactionJournal permissionable create fields (controller uses Security.stripInaccessible CREATABLE).
         Four fields (AccountId, ReferenceRecordId, UsageResourceId, UsageType) are non-permissionable and omitted. -->
    <fieldPermissions>
        <editable>true</editable>
        <field>TransactionJournal.Quantity</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>TransactionJournal.StartDate</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>TransactionJournal.EndDate</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>TransactionJournal.QuantityUnitOfMeasureId</field>
        <readable>true</readable>
    </fieldPermissions>

    <!-- Read-only: Asset/Product2 fields selected or filtered on by the USER_MODE queries above. -->
    <fieldPermissions>
        <editable>false</editable>
        <field>Asset.AccountId</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Asset.Product2Id</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Asset.LifecycleStartDate</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Asset.LifecycleEndDate</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Product2.UsageModelType</field>
        <readable>true</readable>
    </fieldPermissions>

    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Account</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Asset</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>UsageResource</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Product2</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>ProductUsageResource</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
