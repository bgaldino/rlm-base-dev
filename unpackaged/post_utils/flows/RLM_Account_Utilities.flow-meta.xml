    <decisions>
        <description>The pricing decision tables are refreshed only when the reset completed. A reset that stopped rolled back everything but usage records, so the contracts and assets the tables read are unchanged.</description>
        <name>isResetSuccessful</name>
        <label>isResetSuccessful</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Reset_Result</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Stopped</defaultConnectorLabel>
        <rules>
            <name>Completed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>ResetCompleted</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Refresh_Pricing_Discovery_Decision_Tables</targetReference>
            </connector>
