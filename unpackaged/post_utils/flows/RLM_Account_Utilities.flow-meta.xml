    <screens>
        <name>Account_Utility</name>
        <label>Account Utility</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>true</allowPause>
        <connector>
            <targetReference>Reset_Account</targetReference>
        </connector>
        <fields>
            <name>Delete_Assets</name>
            <dataType>Boolean</dataType>
            <defaultValue>
                <booleanValue>true</booleanValue>
            </defaultValue>
            <fieldText>Delete Assets</fieldText>
            <fieldType>InputField</fieldType>
            <helpText>&lt;p&gt;Deletes the account&apos;s assets with their asset relationships and asset rate card entries, and the work orders and cases linked to the assets. When unchecked, the assets and their rate card entries are kept. Usage summaries, entitlements and transaction journals are deleted either way.&lt;/p&gt;</helpText>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>true</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>Delete_Fulfillment</name>
            <dataType>Boolean</dataType>
            <defaultValue>
                <booleanValue>true</booleanValue>
            </defaultValue>
            <fieldText>Delete Fulfillment</fieldText>
            <fieldType>InputField</fieldType>
            <helpText>&lt;p&gt;Deletes the account&apos;s fulfillment records: its fulfillment orders with their line items, the fulfillment plans of its orders with their steps, and its fulfillment assets with their decompositions.&lt;/p&gt;</helpText>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>true</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>Delete_Billing</name>
            <dataType>Boolean</dataType>
            <defaultValue>
                <booleanValue>true</booleanValue>
            </defaultValue>
            <fieldText>Delete Billing</fieldText>
            <fieldType>InputField</fieldType>
            <helpText>&lt;p&gt;Deletes the account&apos;s debit memos, its invoices with their payment schedules and generated documents, and its credit memos, canceling posted ones first. Invoices that are not Draft or Canceled need the Delete Invoice and Invoice Lines permission (permission set RLM_DeleteInvoices); without it they are kept. Payments, and posted or void debit memos, are always kept: Salesforce does not allow deleting them.&lt;/p&gt;</helpText>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>true</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>Delete_Collection_Plans</name>
            <dataType>Boolean</dataType>
            <defaultValue>
                <booleanValue>true</booleanValue>
            </defaultValue>
            <fieldText>Delete Collection Plans</fieldText>
            <fieldType>InputField</fieldType>
            <helpText>&lt;p&gt;Deletes the account&apos;s collection plans with their plan items, promise-to-pay payment schedules and cases, and the account&apos;s disputes, including those raised against its invoices, with their dispute items and cases. The account&apos;s other cases are kept.&lt;/p&gt;</helpText>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>true</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>Preserve_Contracts_With_Contracted_Prices</name>
            <dataType>Boolean</dataType>
            <defaultValue>
                <booleanValue>false</booleanValue>
            </defaultValue>
            <fieldText>Preserve Contracts with Contracted Prices</fieldText>
            <fieldType>InputField</fieldType>
            <helpText>&lt;p&gt;When checked, the account&apos;s contracts that have contracted prices are kept, with those prices and the rate card entries bound to them, and its other contracts are still deleted. The usage resource policies bound to the kept contracts are deleted either way. When unchecked, all of the account&apos;s contracts are deleted.&lt;/p&gt;</helpText>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>true</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Reset_Failed</name>
        <label>Reset Failed</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Reset_FailedText</name>
            <fieldText>&lt;p&gt;&lt;strong&gt;The reset failed.&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;{!$Flow.FaultMessage}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Reset_Result</name>
        <label>Reset Result</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Result_Cleared</name>
            <fieldText>&lt;p&gt;&lt;strong&gt;The account is reset.&lt;/strong&gt; Nothing was kept.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <visibilityRule>
                <conditionLogic>and</conditionLogic>
                <conditions>
                    <leftValueReference>ResetCleared</leftValueReference>
                    <operator>EqualTo</operator>
                    <rightValue>
                        <booleanValue>true</booleanValue>
                    </rightValue>
                </conditions>
            </visibilityRule>
        </fields>
        <fields>
            <name>Result_Partial</name>
            <fieldText>&lt;p&gt;&lt;strong&gt;The reset finished, but some records were kept.&lt;/strong&gt; They are listed below with the reason.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <visibilityRule>
                <conditionLogic>and</conditionLogic>
                <conditions>
                    <leftValueReference>ResetCompleted</leftValueReference>
                    <operator>EqualTo</operator>
                    <rightValue>
                        <booleanValue>true</booleanValue>
                    </rightValue>
                </conditions>
                <conditions>
                    <leftValueReference>ResetCleared</leftValueReference>
                    <operator>EqualTo</operator>
                    <rightValue>
                        <booleanValue>false</booleanValue>
                    </rightValue>
                </conditions>
            </visibilityRule>
        </fields>
        <fields>
            <name>Result_Stopped</name>
            <fieldText>&lt;p&gt;&lt;strong&gt;The reset stopped before it finished.&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;{!ResetReason}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <visibilityRule>
                <conditionLogic>and</conditionLogic>
                <conditions>
                    <leftValueReference>ResetCompleted</leftValueReference>
                    <operator>EqualTo</operator>
                    <rightValue>
                        <booleanValue>false</booleanValue>
                    </rightValue>
                </conditions>
            </visibilityRule>
        </fields>
        <fields>
            <name>Result_Removed</name>
            <fieldText>&lt;p&gt;&lt;strong&gt;Removed:&lt;/strong&gt; {!ResetRemoved}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <visibilityRule>
                <conditionLogic>and</conditionLogic>
                <conditions>
                    <leftValueReference>ResetRemoved</leftValueReference>
                    <operator>IsNull</operator>
                    <rightValue>
                        <booleanValue>false</booleanValue>
                    </rightValue>
                </conditions>
            </visibilityRule>
        </fields>
        <fields>
            <name>Result_Retained</name>
            <fieldText>&lt;p&gt;&lt;strong&gt;Kept:&lt;/strong&gt; {!ResetRetained}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <visibilityRule>
                <conditionLogic>and</conditionLogic>
                <conditions>
                    <leftValueReference>ResetRetained</leftValueReference>
                    <operator>IsNull</operator>
                    <rightValue>
                        <booleanValue>false</booleanValue>
                    </rightValue>
                </conditions>
            </visibilityRule>
        </fields>
        <fields>
            <name>Result_Refresh</name>
            <fieldText>&lt;p&gt;&lt;strong&gt;Pricing decision tables:&lt;/strong&gt; {!Refresh_Pricing_Discovery_Decision_Tables.queuedCount} queued for refresh, {!Refresh_Pricing_Discovery_Decision_Tables.failedCount} failed. A queued refresh finishes in the background; the Decision Table Manager shows its status.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <visibilityRule>
                <conditionLogic>1 AND 2 AND (3 OR 4)</conditionLogic>
                <conditions>
                    <leftValueReference>ResetCompleted</leftValueReference>
                    <operator>EqualTo</operator>
                    <rightValue>
                        <booleanValue>true</booleanValue>
                    </rightValue>
                </conditions>
                <conditions>
                    <leftValueReference>Refresh_Pricing_Discovery_Decision_Tables.faultMessage</leftValueReference>
                    <operator>IsNull</operator>
                    <rightValue>
                        <booleanValue>true</booleanValue>
                    </rightValue>
                </conditions>
                <conditions>
                    <leftValueReference>Refresh_Pricing_Discovery_Decision_Tables.queuedCount</leftValueReference>
                    <operator>GreaterThan</operator>
                    <rightValue>
                        <numberValue>0.0</numberValue>
                    </rightValue>
                </conditions>
                <conditions>
                    <leftValueReference>Refresh_Pricing_Discovery_Decision_Tables.failedCount</leftValueReference>
                    <operator>GreaterThan</operator>
                    <rightValue>
                        <numberValue>0.0</numberValue>
                    </rightValue>
                </conditions>
            </visibilityRule>
        </fields>
        <fields>
            <name>Result_Refresh_Failed</name>
            <fieldText>&lt;p&gt;Not refreshed: {!Refresh_Pricing_Discovery_Decision_Tables.failedApiNames}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <visibilityRule>
                <conditionLogic>and</conditionLogic>
                <conditions>
                    <leftValueReference>Refresh_Pricing_Discovery_Decision_Tables.failedCount</leftValueReference>
                    <operator>GreaterThan</operator>
                    <rightValue>
                        <numberValue>0.0</numberValue>
                    </rightValue>
                </conditions>
            </visibilityRule>
        </fields>
        <fields>
            <name>Result_Refresh_None</name>
            <fieldText>&lt;p&gt;&lt;strong&gt;Pricing decision tables:&lt;/strong&gt; none refreshed. No active decision table has the PricingDiscovery usage type in this org.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <visibilityRule>
                <conditionLogic>and</conditionLogic>
                <conditions>
                    <leftValueReference>ResetCompleted</leftValueReference>
                    <operator>EqualTo</operator>
                    <rightValue>
                        <booleanValue>true</booleanValue>
                    </rightValue>
                </conditions>
                <conditions>
                    <leftValueReference>Refresh_Pricing_Discovery_Decision_Tables.faultMessage</leftValueReference>
                    <operator>IsNull</operator>
                    <rightValue>
                        <booleanValue>true</booleanValue>
                    </rightValue>
                </conditions>
                <conditions>
                    <leftValueReference>Refresh_Pricing_Discovery_Decision_Tables.queuedCount</leftValueReference>
                    <operator>EqualTo</operator>
                    <rightValue>
                        <numberValue>0.0</numberValue>
                    </rightValue>
                </conditions>
                <conditions>
                    <leftValueReference>Refresh_Pricing_Discovery_Decision_Tables.failedCount</leftValueReference>
                    <operator>EqualTo</operator>
                    <rightValue>
                        <numberValue>0.0</numberValue>
                    </rightValue>
                </conditions>
            </visibilityRule>
        </fields>
        <fields>
            <name>Result_Refresh_Fault</name>
            <fieldText>&lt;p&gt;&lt;strong&gt;The pricing decision tables were not refreshed.&lt;/strong&gt; Refresh them from the Decision Table Manager.&lt;/p&gt;&lt;p&gt;{!Refresh_Pricing_Discovery_Decision_Tables.faultMessage}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <visibilityRule>
                <conditionLogic>and</conditionLogic>
                <conditions>
                    <leftValueReference>Refresh_Pricing_Discovery_Decision_Tables.faultMessage</leftValueReference>
                    <operator>IsNull</operator>
                    <rightValue>
                        <booleanValue>false</booleanValue>
                    </rightValue>
                </conditions>
            </visibilityRule>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
