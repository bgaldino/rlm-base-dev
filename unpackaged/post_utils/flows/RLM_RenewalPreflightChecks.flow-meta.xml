    <decisions>
        <description>The quote action renews this asset, and one of its lines starts the second after the asset ends now, so ordering that quote would renew the asset's current term. A line from a renewal already ordered and activated starts after an earlier end, so it doesn't match.</description>
        <name>Is_Pending_Renewal</name>
        <label>Is Pending Renewal</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Loop_Action_Assets</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Pending_Renewal</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Action_Assets.Id</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Loop_Pending_Actions.SourceAssetId</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>RenewLineKeys</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>PendingRenewalKey</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Has_Pending_Renewal_Quote</targetReference>
            </connector>
            <label>Pending Renewal</label>
        </rules>
    </decisions>
