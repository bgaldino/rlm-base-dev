    <decisions>
        <description>A line of this quote action ends after the asset ends now, so ordering that quote would renew the asset past its current term, whatever the line&apos;s start (the default second after the end, a later start, or an early renewal). A renewal already ordered and activated has moved the asset&apos;s end to its line&apos;s end, so its lines don&apos;t match.</description>
        <name>Is_Pending_Renewal</name>
        <label>Is Pending Renewal</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Loop_Action_Lines</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Pending_Renewal</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Action_Lines.QuoteActionId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Loop_Pending_Actions.Id</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_Action_Lines.EndDateTime</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <elementReference>Loop_Action_Assets.LifecycleEndDate</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Has_Pending_Renewal_Quote</targetReference>
            </connector>
            <label>Pending Renewal</label>
        </rules>
    </decisions>
