        <value>
            <booleanValue>false</booleanValue>
        </value>
    </variables>
    <variables>
        <description>True when any of OpportunityIds already has a quote.</description>
        <name>HasQuote</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <value>
            <booleanValue>false</booleanValue>
        </value>
    </variables>
</Flow>
