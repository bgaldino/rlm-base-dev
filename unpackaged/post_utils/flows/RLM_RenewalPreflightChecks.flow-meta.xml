    </loops>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Renew quote actions for these assets on any quote, on any opportunity, open or closed. Any quote can still be ordered, so one that would renew an asset's current term would renew it a second time.</description>
        <name>Get_Renew_Actions</name>
        <label>Get Renew Actions</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Has_Renew_Actions</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Type</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Renew</stringValue>
            </value>
        </filters>
        <filters>
            <field>SourceAssetId</field>
            <operator>In</operator>
            <value>
                <elementReference>AssetIds</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>QuoteAction</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>SourceAssetId</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>The quote lines those actions created, with their exact start. StartDateTime isn't filtered on, since a filter on it returns no rows; a line without one gets a key no asset can match.</description>
        <name>Get_Renew_Lines</name>
        <label>Get Renew Lines</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Renew_Lines</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>QuoteActionId</field>
            <operator>In</operator>
            <value>
                <elementReference>RenewActionIds</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>QuoteLineItem</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>QuoteActionId</queriedFields>
        <queriedFields>StartDateTime</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>When each asset ends now.</description>
        <name>Get_Renewed_Assets</name>
        <label>Get Renewed Assets</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
