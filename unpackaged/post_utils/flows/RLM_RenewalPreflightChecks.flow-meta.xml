    <description>Checks, before RLM_ConsolidateRenewalOpportunities renews anything, whether any of the given root assets has an asset state period in a time zone other than GMT (a period with no time zone uses GMT) or in a ramp, and whether any of the given opportunities already has a quote. Runs in system context without sharing: Start End Time Zone and the ramp fields on Asset State Period are usually hidden by field-level security, which would fail a read in user context, and a quote the user can't see could still be ordered and renew the same assets. It is given the root assets and opportunities the caller already read and returns only a yes or no for each check, never a record, an Id or a field value.</description>
    <environments>Default</environments>
    <interviewLabel>RLM Renewal Preflight Checks {!$Flow.CurrentDateTime}</interviewLabel>
    <label>RLM Renewal Preflight Checks</label>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Non_Gmt_Period</name>
        <label>Get Non-GMT Period</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Has_Non_Gmt_Period</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AssetId</field>
            <operator>In</operator>
            <value>
                <elementReference>AssetIds</elementReference>
            </value>
        </filters>
        <filters>
            <field>StartEndTimeZone</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>StartEndTimeZone</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>GMT</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>AssetStatePeriod</object>
        <queriedFields>Id</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>A quote, of any status, on one of the opportunities. Any quote can still be turned into an order whatever its status, and activating that order renews its assets, so once this consolidation's quote exists the same assets could be renewed twice.</description>
        <name>Get_Quote</name>
        <label>Get Quote</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Has_Quote</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>OpportunityId</field>
            <operator>In</operator>
            <value>
                <elementReference>OpportunityIds</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Quote</object>
        <queriedFields>Id</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>A period in a ramp. A ramped asset renews as a ramp, segment by segment, which a cotermed renewal doesn't handle.</description>
        <name>Get_Ramped_Period</name>
        <label>Get Ramped Period</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Has_Ramped_Period</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AssetId</field>
            <operator>In</operator>
            <value>
                <elementReference>AssetIds</elementReference>
            </value>
        </filters>
        <filters>
            <field>RampIdentifier</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>AssetStatePeriod</object>
        <queriedFields>Id</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <runInMode>SystemModeWithoutSharing</runInMode>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Has_Assets</targetReference>
        </connector>
    </start>
    <status>Active</status>
