            </connector>
            <label>Already Added</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_New_Root_Asset</name>
        <label>Is New Root Asset</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Add_Root_Asset_Id</targetReference>
