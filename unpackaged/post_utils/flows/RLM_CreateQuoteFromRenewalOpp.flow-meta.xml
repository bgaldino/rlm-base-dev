    <decisions>
        <description>Stops before quoting when this opportunity already has a quote, or a quote on any opportunity has a renewal of these assets that hasn&apos;t been ordered and activated: either could still be ordered, and activating it would renew the same assets again.</description>
        <name>Has_Existing_Renewal</name>
        <label>Has Existing Renewal</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Initiate_Renewal_Quote</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>None</defaultConnectorLabel>
        <rules>
            <name>Existing_Quote</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>HasQuote</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Existing_Renewal_Quote</targetReference>
            </connector>
            <label>Existing Quote</label>
        </rules>
        <rules>
            <name>Pending_Renewal_Quote</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>HasPendingRenewalQuote</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Existing_Renewal_Quote</targetReference>
            </connector>
            <label>Pending Renewal Quote</label>
        </rules>
    </decisions>
    <decisions>
        <description>The asset lookup runs as the user, so assets they can&apos;t read are silently left out. Renewing only the readable subset would create a renewal quote missing products, so stop instead.</description>
        <name>Are_All_Assets_Readable</name>
        <label>Are All Assets Readable</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Assets_Not_Readable</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Some Missing</defaultConnectorLabel>
        <rules>
            <name>All_Readable</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>ReadableAssetCount</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>LineAssetCount</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_Renewal_Assets</targetReference>
            </connector>
            <label>All Readable</label>
        </rules>
    </decisions>
    <decisions>
        <name>Has_Renewable_Assets</name>
        <label>Has Renewable Assets</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>No_Renewable_Assets</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_Has_Assets</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>RenewAssetCount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Confirm_Renewal_Quote</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <description>Same rule as the action&apos;s visibility on the record page: only an open renewal opportunity (Type Existing Business) gets a renewal quote, so a won renewal can&apos;t be renewed twice.</description>
        <name>Is_Open_Renewal</name>
        <label>Is Open Renewal</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Not_Open_Renewal</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Open Renewal</defaultConnectorLabel>
        <rules>
            <name>Open_Renewal</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Renewal_Opportunity.Type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Existing Business</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Renewal_Opportunity.IsClosed</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Renewal_Lines</targetReference>
            </connector>
            <label>Open Renewal</label>
        </rules>
    </decisions>
    <decisions>
        <description>Keeps LineAssetIds distinct, so its count can be compared with the assets read.</description>
        <name>Is_New_Line_Asset</name>
