    <subflows>
        <description>Reads, in system context without sharing, whether this opportunity already has a quote and whether a quote on any opportunity, open or closed, has a renewal of these assets that hasn&apos;t been ordered and activated; a quote the user can&apos;t see still counts. Runs after the confirmation screen, so a second run started before the first finished still stops. Only those two answers are used here.</description>
        <name>Run_Preflight_Checks</name>
        <label>Run Preflight Checks</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Has_Existing_Renewal</targetReference>
        </connector>
        <flowName>RLM_RenewalPreflightChecks</flowName>
        <inputAssignments>
            <name>AssetIds</name>
            <value>
                <elementReference>RenewAssetIds</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>OpportunityIds</name>
            <value>
                <elementReference>OpportunityIds</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
