<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <description>Standard Initiate Renewal action. Passing the opportunity (and its contract, when set) syncs the renewal quote to them; the assets are the root assets of the renewal opportunity&apos;s lines.</description>
        <name>Initiate_Renewal_Quote</name>
        <label>Initiate Renewal Quote</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>initiateRenewal</actionName>
        <actionType>initiateRenewal</actionType>
        <connector>
            <targetReference>Quote_Redirect</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Renewal_Quote_Error</targetReference>
        </faultConnector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>renewAssetIds</name>
            <value>
                <elementReference>RenewAssetIds</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>renewOutputType</name>
            <value>
                <stringValue>Quote</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>renewOpportunityId</name>
            <value>
                <elementReference>Get_Renewal_Opportunity.Id</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>renewContractId</name>
            <value>
                <elementReference>Get_Renewal_Opportunity.ContractId</elementReference>
            </value>
        </inputParameters>
        <nameSegment>initiateRenewal</nameSegment>
        <offset>0</offset>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <apiVersion>68.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Add_Asset_Id</name>
        <label>Add Asset Id</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>LineAssetIds</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Renewal_Lines.AssetId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Renewal_Lines</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Bundle components renew with their bundle, so only the root asset is passed to Initiate Renewal.</description>
        <name>Add_Root_Asset_Id</name>
        <label>Add Root Asset Id</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>RenewAssetIds</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Renewal_Assets.RootAssetId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Renewal_Assets</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Count_Renew_Assets</name>
        <label>Count Renew Assets</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>RenewAssetCount</assignToReference>
            <operator>AssignCount</operator>
            <value>
                <elementReference>RenewAssetIds</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Has_Renewable_Assets</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Has_Renewable_Assets</name>
        <label>Has Renewable Assets</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>No_Renewable_Assets</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_Has_Assets</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>RenewAssetCount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Confirm_Renewal_Quote</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_New_Root_Asset</name>
        <label>Is New Root Asset</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Add_Root_Asset_Id</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>New</defaultConnectorLabel>
        <rules>
            <name>Already_Added</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>RenewAssetIds</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>Loop_Renewal_Assets.RootAssetId</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_Renewal_Assets</targetReference>
            </connector>
            <label>Already Added</label>
        </rules>
    </decisions>
    <description>Quick action on a renewal Opportunity (created by RLM_CreateUpdateRenewalOpportunities). Renews the root assets referenced by the opportunity&apos;s lines (OpportunityLineItem.AssetId, mapped to Asset.RootAssetId so bundle components renew with their bundle) through the standard Initiate Renewal action, linking the resulting quote to the opportunity and, when set, its contract, then opens the quote.</description>
    <environments>Default</environments>
    <interviewLabel>RLM Create Quote from Renewal Opp {!$Flow.CurrentDateTime}</interviewLabel>
    <label>RLM Create Quote from Renewal Opp</label>
    <loops>
        <name>Loop_Renewal_Lines</name>
        <label>Loop Renewal Lines</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Renewal_Lines</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Add_Asset_Id</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Get_Renewal_Assets</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>Loop_Renewal_Assets</name>
        <label>Loop Renewal Assets</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Renewal_Assets</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Is_New_Root_Asset</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Count_Renew_Assets</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordLookups>
        <name>Get_Renewal_Assets</name>
        <label>Get Renewal Assets</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Renewal_Assets</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Renewal_Quote_Error</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>In</operator>
            <value>
                <elementReference>LineAssetIds</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Asset</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>RootAssetId</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Renewal_Lines</name>
        <label>Get Renewal Lines</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Renewal_Lines</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Renewal_Quote_Error</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>OpportunityId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Renewal_Opportunity.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>AssetId</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>OpportunityLineItem</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>AssetId</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Renewal_Opportunity</name>
        <label>Get Renewal Opportunity</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Renewal_Lines</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Renewal_Quote_Error</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Opportunity</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
        <queriedFields>ContractId</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <screens>
        <name>Confirm_Renewal_Quote</name>
        <label>Confirm Renewal Quote</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Initiate_Renewal_Quote</targetReference>
        </connector>
        <fields>
            <name>ConfirmationText</name>
            <fieldText>&lt;p&gt;Create a renewal quote for &lt;strong&gt;{!Get_Renewal_Opportunity.Name}&lt;/strong&gt;?&lt;/p&gt;&lt;p&gt;{!RenewAssetCount} asset(s) from this opportunity&apos;s lines will be renewed, and the quote will be linked to this opportunity (and its contract, if one is set).&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <nextOrFinishButtonLabel>Create Quote</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>No_Renewable_Assets</name>
        <label>No Renewable Assets</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>NoAssetsText</name>
            <fieldText>&lt;p&gt;&lt;strong&gt;{!Get_Renewal_Opportunity.Name}&lt;/strong&gt; has no products linked to an asset, so there is nothing to renew.&lt;/p&gt;&lt;p&gt;This action works on renewal opportunities created when an order is activated into assets.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Quote_Redirect</name>
        <label>Quote Redirect</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Redirect</name>
            <extensionName>c:rlmQuoteRedirect</extensionName>
            <fieldType>ComponentInstance</fieldType>
            <inputParameters>
                <name>quoteId</name>
                <value>
                    <elementReference>Initiate_Renewal_Quote.renewRecordId</elementReference>
                </value>
            </inputParameters>
            <inputParameters>
                <name>disableAutoRedirect</name>
                <value>
                    <booleanValue>false</booleanValue>
                </value>
            </inputParameters>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>true</isRequired>
            <storeOutputAutomatically>true</storeOutputAutomatically>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Renewal_Quote_Error</name>
        <label>Renewal Quote Error</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>ErrorText</name>
            <fieldText>&lt;p&gt;&lt;strong&gt;The renewal quote was not created.&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;{!$Flow.FaultMessage}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Renewal_Opportunity</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <description>Renewal Opportunity Id, supplied by the Opportunity.RLM_CreateQuoteFromRenewalOpp quick action.</description>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>Asset Ids read from the renewal opportunity&apos;s lines; may include bundle components and repeats.</description>
        <name>LineAssetIds</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>RenewAssetCount</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
    </variables>
    <variables>
        <description>Distinct root Asset Ids for the renewal opportunity&apos;s lines, passed to Initiate Renewal.</description>
        <name>RenewAssetIds</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
