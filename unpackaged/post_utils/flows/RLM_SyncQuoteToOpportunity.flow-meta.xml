    <recordUpdates>
        <description>Makes this quote the opportunity&apos;s synced quote and sets the opportunity&apos;s price book to the quote&apos;s in the same update: a sync needs them to match, and an opportunity with no price book rejects the synced quote alone. An opportunity whose products come from a different price book rejects the update, and the error screen shows why.</description>
        <name>Set_Synced_Quote</name>
        <label>Set Synced Quote</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Sync_Quote_To_Opportunity</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Sync_Error</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Opportunity.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Pricebook2Id</field>
            <value>
                <elementReference>Get_Quote.Pricebook2Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>SyncedQuoteId</field>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </inputAssignments>
        <object>Opportunity</object>
    </recordUpdates>
