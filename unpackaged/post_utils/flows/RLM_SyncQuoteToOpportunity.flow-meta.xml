<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <description>Standard Sync Quote to Opportunity action. It copies the quote&apos;s lines to the opportunity&apos;s products; with Asynchronous Opportunity Sync on, writing the synced quote alone marks the quote as syncing without copying anything. A standard quote is copied before the action returns, with no tracker Id; a large quote is queued as a background job and the action returns its tracker Id.</description>
        <name>Sync_Quote_To_Opportunity</name>
        <label>Sync Quote to Opportunity</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>syncQuoteOpportunity</actionName>
        <actionType>syncQuoteOpportunity</actionType>
        <connector>
            <targetReference>Was_Sync_Accepted</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Roll_Back_Failed_Sync</targetReference>
        </faultConnector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>quoteId</name>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </inputParameters>
        <nameSegment>syncQuoteOpportunity</nameSegment>
        <offset>0</offset>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <apiVersion>68.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <description>A quote syncs only to its own opportunity, and a quote without a price book has no products to sync.</description>
        <name>Can_Sync</name>
        <label>Can Sync</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_Opportunity</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Can Sync</defaultConnectorLabel>
        <rules>
            <name>Quote_Has_No_Opportunity</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Quote.OpportunityId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>No_Opportunity</targetReference>
            </connector>
            <label>No Opportunity</label>
        </rules>
        <rules>
            <name>Quote_Has_No_Price_Book</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Quote.Pricebook2Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>No_Price_Book</targetReference>
            </connector>
            <label>No Price Book</label>
        </rules>
    </decisions>
