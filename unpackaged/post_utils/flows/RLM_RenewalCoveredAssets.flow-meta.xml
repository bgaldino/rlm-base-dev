<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Add_Open_Renewal_Id</name>
        <label>Add Open Renewal Id</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>OpenRenewalIds</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Open_Renewals.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Open_Renewals</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Add_Covered_Line_Asset</name>
        <label>Add Covered Line Asset</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>CoveredAssetIds</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Open_Renewal_Lines.AssetId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Open_Renewal_Lines</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Add_Open_Renewal_Quote_Id</name>
        <label>Add Open Renewal Quote Id</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>OpenRenewalQuoteIds</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Open_Renewal_Quotes.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Open_Renewal_Quotes</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Add_Covered_Quote_Asset</name>
        <label>Add Covered Quote Asset</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>CoveredAssetIds</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Renew_Quote_Actions.SourceAssetId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Renew_Quote_Actions</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Add_Covered_Root_Asset_Id</name>
        <label>Add Covered Root Asset Id</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>CoveredRootAssetIds</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Covered_Assets.RootAssetId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Covered_Assets</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Has_Open_Renewals</name>
        <label>Has Open Renewals</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>None</defaultConnectorLabel>
        <rules>
            <name>Open_Renewals_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Open_Renewals</leftValueReference>
                <operator>IsEmpty</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_Open_Renewals</targetReference>
            </connector>
            <label>Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Has_Open_Renewal_Quotes</name>
        <label>Has Open Renewal Quotes</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Has_Covered_Assets</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>None</defaultConnectorLabel>
        <rules>
            <name>Open_Renewal_Quotes_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Open_Renewal_Quotes</leftValueReference>
                <operator>IsEmpty</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_Open_Renewal_Quotes</targetReference>
            </connector>
            <label>Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Has_Covered_Assets</name>
        <label>Has Covered Assets</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>None</defaultConnectorLabel>
        <rules>
            <name>Covered_Assets_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>CoveredAssetIds</leftValueReference>
                <operator>IsEmpty</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Covered_Assets</targetReference>
            </connector>
            <label>Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_New_Covered_Root</name>
        <label>Is New Covered Root</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Add_Covered_Root_Asset_Id</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>New</defaultConnectorLabel>
        <rules>
            <name>Covered_Root_Already_Added</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>CoveredRootAssetIds</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>Loop_Covered_Assets.RootAssetId</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_Covered_Assets</targetReference>
            </connector>
            <label>Already Added</label>
        </rules>
    </decisions>
    <description>Returns the root assets that an open renewal opportunity on the account already covers, through its lines or its quotes' Renew quote actions, normalized to RootAssetId so a covered bundle component marks its root covered. Runs in system context without sharing so the answer doesn't depend on which opportunities the running user can see: called by RLM_ConsolidateRenewalOpportunities to decide which of the account's assets no renewal covers, and it returns only Asset Ids, never the opportunities or quotes.</description>
    <environments>Default</environments>
    <interviewLabel>RLM Renewal Covered Assets {!$Flow.CurrentDateTime}</interviewLabel>
    <label>RLM Renewal Covered Assets</label>
    <loops>
        <name>Loop_Open_Renewals</name>
        <label>Loop Open Renewals</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Open_Renewals</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Add_Open_Renewal_Id</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Get_Open_Renewal_Lines</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>Loop_Open_Renewal_Lines</name>
        <label>Loop Open Renewal Lines</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Open_Renewal_Lines</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Add_Covered_Line_Asset</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Get_Open_Renewal_Quotes</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>Loop_Open_Renewal_Quotes</name>
        <label>Loop Open Renewal Quotes</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Open_Renewal_Quotes</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Add_Open_Renewal_Quote_Id</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Get_Renew_Quote_Actions</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>Loop_Renew_Quote_Actions</name>
        <label>Loop Renew Quote Actions</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Renew_Quote_Actions</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Add_Covered_Quote_Asset</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Has_Covered_Assets</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>Loop_Covered_Assets</name>
        <label>Loop Covered Assets</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Covered_Assets</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Is_New_Covered_Root</targetReference>
        </nextValueConnector>
    </loops>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Every open renewal on the account, whatever its price book: their assets are already being renewed, so they are not offered as extra assets.</description>
        <name>Get_Open_Renewals</name>
        <label>Get Open Renewals</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Has_Open_Renewals</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AccountId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>AccountId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Type</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Existing Business</stringValue>
            </value>
        </filters>
        <filters>
            <field>IsClosed</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Opportunity</object>
        <queriedFields>Id</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Open_Renewal_Lines</name>
        <label>Get Open Renewal Lines</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Open_Renewal_Lines</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>OpportunityId</field>
            <operator>In</operator>
            <value>
                <elementReference>OpenRenewalIds</elementReference>
            </value>
        </filters>
        <filters>
            <field>AssetId</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>OpportunityLineItem</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>AssetId</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Open_Renewal_Quotes</name>
        <label>Get Open Renewal Quotes</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Has_Open_Renewal_Quotes</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>OpportunityId</field>
            <operator>In</operator>
            <value>
                <elementReference>OpenRenewalIds</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Quote</object>
        <queriedFields>Id</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>A consolidated quote isn't synced, so the assets it absorbed are on no open opportunity's lines; its renew quote actions still name them.</description>
        <name>Get_Renew_Quote_Actions</name>
        <label>Get Renew Quote Actions</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Renew_Quote_Actions</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>QuoteId</field>
            <operator>In</operator>
            <value>
                <elementReference>OpenRenewalQuoteIds</elementReference>
            </value>
        </filters>
        <filters>
            <field>Type</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Renew</stringValue>
            </value>
        </filters>
        <filters>
            <field>SourceAssetId</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>QuoteAction</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>SourceAssetId</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Lines and quote actions can name bundle components; the account assets are compared by root, so each covered asset is mapped to its RootAssetId.</description>
        <name>Get_Covered_Assets</name>
        <label>Get Covered Assets</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Covered_Assets</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>In</operator>
            <value>
                <elementReference>CoveredAssetIds</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Asset</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>RootAssetId</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <runInMode>SystemModeWithoutSharing</runInMode>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Open_Renewals</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <description>The account whose open renewal opportunities are read.</description>
        <name>AccountId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>Distinct root Asset Ids covered by an open renewal opportunity's lines or its quotes' Renew quote actions.</description>
        <name>CoveredRootAssetIds</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <description>Asset Ids on the open renewals' lines and Renew quote actions, as recorded; may include bundle components.</description>
        <name>CoveredAssetIds</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>Every open renewal opportunity on the account.</description>
        <name>OpenRenewalIds</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>Quotes linked to an open renewal opportunity on the account.</description>
        <name>OpenRenewalQuoteIds</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
