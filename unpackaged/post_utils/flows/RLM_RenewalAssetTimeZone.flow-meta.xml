<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Set_Has_Non_Gmt_Time_Zone</name>
        <label>Set Has Non-GMT Time Zone</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>HasNonGmtTimeZone</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <description>Nothing to check, so nothing is read.</description>
        <name>Has_Assets</name>
        <label>Has Assets</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>None</defaultConnectorLabel>
        <rules>
            <name>Assets</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>AssetIds</leftValueReference>
                <operator>IsEmpty</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Non_Gmt_Period</targetReference>
            </connector>
            <label>Assets</label>
        </rules>
    </decisions>
    <decisions>
        <name>Has_Non_Gmt_Period</name>
        <label>Has Non-GMT Period</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>All GMT</defaultConnectorLabel>
        <rules>
            <name>Non_Gmt_Period_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Non_Gmt_Period</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Has_Non_Gmt_Time_Zone</targetReference>
            </connector>
            <label>Non-GMT Period Found</label>
        </rules>
    </decisions>
    <description>Tells whether any of the given assets has an asset state period in a time zone other than GMT (a period with no time zone uses GMT). Runs in system context because Start End Time Zone on Asset State Period is usually hidden by field-level security, which would fail a read in user context. Called by RLM_ConsolidateRenewalOpportunities, which coterms only GMT assets. It returns only a yes or no, never a time zone or an Id.</description>
    <environments>Default</environments>
    <interviewLabel>RLM Renewal Asset Time Zone {!$Flow.CurrentDateTime}</interviewLabel>
    <label>RLM Renewal Asset Time Zone</label>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Non_Gmt_Period</name>
        <label>Get Non-GMT Period</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Has_Non_Gmt_Period</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AssetId</field>
            <operator>In</operator>
            <value>
                <elementReference>AssetIds</elementReference>
            </value>
        </filters>
        <filters>
            <field>StartEndTimeZone</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>StartEndTimeZone</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>GMT</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>AssetStatePeriod</object>
        <queriedFields>Id</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <runInMode>SystemModeWithoutSharing</runInMode>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Has_Assets</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <description>Root Asset Ids the caller already read with its own sharing.</description>
        <name>AssetIds</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>True when any of AssetIds has a period in a time zone other than GMT.</description>
        <name>HasNonGmtTimeZone</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <value>
            <booleanValue>false</booleanValue>
        </value>
    </variables>
</Flow>
