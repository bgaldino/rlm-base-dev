<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <!-- todo 292: for RLM_Billing_Admin and RLM_Billing_Operations users, next to the licensed DocGen sets.
         Read and View All on Invoice Batch Run (Private; the batch action runs from it), with the
         scheduler and run-criteria reads the deploy requires, and Access Libraries, so a template
         library member can read the template file. No license, so it can sit in both groups.
         Evidence: docs/references/revenue-cloud-permissions.md, "Billing personas and invoice documents". -->
    <description>Invoice documents for the RLM Billing Admin and RLM Billing Operations groups: Read and View All on Invoice Batch Runs (with scheduler and run criteria) and Access Libraries for the template file. DocGen sets go next to the group.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <label>RLM Billing Invoice Documents</label>
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>BillingBatchScheduler</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>InvoiceBatchRun</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>InvoiceBatchRunCriteria</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>
    <userPermissions>
        <enabled>true</enabled>
        <name>ContentWorkspaces</name>
    </userPermissions>
</PermissionSet>
