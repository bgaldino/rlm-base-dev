<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <!-- Owner decision (todo 452, 2026-11-26): the Billing Operations persona reads collection plans,
         so the account balance cards can tell whether an account is in collections and show its
         promises to pay. CollectionPlan is readable only with the Collections and Recovery Specialist
         user permission, which the user license allows only with the Billing Advanced permission set
         license (measured on a 264 org): a user assigned this set must also hold BillingAdvancedPsl.
         Read only; the collections role's write access stays with BillingCollectionsAndRecoverySpecialist. -->
    <description>Lets the RLM Billing Operations persona read collection plans and their items (read only). The assignee needs the Billing Advanced permission set license.</description>
    <fieldPermissions>
        <editable>false</editable>
        <field>CollectionPlan.AccountId</field>
        <readable>true</readable>
    </fieldPermissions>
    <hasActivationRequired>false</hasActivationRequired>
    <label>RLM Billing Operations Collections</label>
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>CollectionPlan</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>CollectionPlanItem</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <userPermissions>
        <enabled>true</enabled>
        <name>CollectionsAndRecoverySpecialist</name>
    </userPermissions>
</PermissionSet>
