<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <!-- Owner decision (todo 452, 2026-11-26): the billing personas (RLM Billing Operations, RLM Billing
         Admin, RLM Credit Memo Operations) read collection plans, so the account balance cards can tell
         whether an account is in collections and show its promises to pay. A standalone set, assigned
         to those users next to their persona group, deliberately not in any group: a group with it
         fails to deploy while any holder lacks the licence below (measured), and no group's
         managed role set carries this read.
         CollectionPlan is readable only with the Collections and Recovery Specialist user permission,
         which the user license allows only with the Billing Advanced permission set license (measured
         on a 264 org): the assignee must also hold BillingAdvancedPsl. Read only; collections writes
         stay with BillingCollectionsAndRecoverySpecialist. The object grants and the CollectionPlan.AccountId
         field grant are copied here (RLM_BillingUI has them too); the account balance cards still need
         RLM_BillingUI for their Apex classes and other reads. -->
    <description>Read-only collection plans and their items for the billing personas (Billing Operations, Billing Admin, Credit Memo Operations), assigned next to their group. The assignee needs the Billing Advanced permission set license.</description>
    <fieldPermissions>
        <editable>false</editable>
        <field>CollectionPlan.AccountId</field>
        <readable>true</readable>
    </fieldPermissions>
    <hasActivationRequired>false</hasActivationRequired>
    <label>RLM Billing Collections Read</label>
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>CollectionPlan</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>CollectionPlanItem</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <userPermissions>
        <enabled>true</enabled>
        <name>CollectionsAndRecoverySpecialist</name>
    </userPermissions>
</PermissionSet>
