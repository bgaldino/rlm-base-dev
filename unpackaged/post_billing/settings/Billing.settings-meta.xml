<?xml version="1.0" encoding="UTF-8"?>
<BillingSettings xmlns="http://soap.sforce.com/2006/04/metadata">
    <billingContextDefinition>RLM_BillingContext</billingContextDefinition>
    <enableBillingDisputeManagement>true</enableBillingDisputeManagement>
    <enableBillingSetup>true</enableBillingSetup>
    <enableConvertedCrMemoCrMemoLnAppln>true</enableConvertedCrMemoCrMemoLnAppln>
    <enableCrMemoApplicationToPostedInvoices>true</enableCrMemoApplicationToPostedInvoices>
    <enableCreditMemoSequenceService>true</enableCreditMemoSequenceService>
    <enableDunningOrchestration>true</enableDunningOrchestration>
    <enableEnhancedPaymentData>true</enableEnhancedPaymentData>
    <enableAutomaticRefunds>true</enableAutomaticRefunds>
    <enableFailedPaymentsRetry>true</enableFailedPaymentsRetry>
    <enableForeignExchangeTrxnJrnlCreation>true</enableForeignExchangeTrxnJrnlCreation>
    <enableInvoiceEmailDelivery>true</enableInvoiceEmailDelivery>
    <enableInvoicePdfGeneration>true</enableInvoicePdfGeneration>
    <enableInvoiceSequenceService>true</enableInvoiceSequenceService>
    <enableMilestoneBillingForAmend>true</enableMilestoneBillingForAmend>
    <enableNegInvoiceLnConversionToCrMemoLn>true</enableNegInvoiceLnConversionToCrMemoLn>
    <enablePaymentApplicationToPostedInvoices>true</enablePaymentApplicationToPostedInvoices>
    <enablePaymentSchedulesAndItemsCreation>true</enablePaymentSchedulesAndItemsCreation>
    <enableTransactionJournalCreation>true</enableTransactionJournalCreation>
    <!-- Credit, Payment, and Refund Application: false = Line Level, true = Header Level
         (org pref InvHeaderLvlSettlement). The Metadata API reference says true "applies
         balances of credit memos to invoices" (the header). Live 264, 2026-10-15: with false,
         applyPayment rejects an invoice id ("Credit Application Level is Invoice Line"). Line Level applies
         credit memo and payment lines to invoice lines (CreditMemoLineInvoiceLine,
         PaymentLineInvoiceLine) instead of to the invoice header. Changing it on an org that
         already has invoices causes tax summary differences (Help: billing tax summary
         difference). Re-running prepare_billing on an existing org switches it to Line Level;
         its earlier header-level applications stay as they are. -->
    <enableTransactionsApplicationToInvoices>false</enableTransactionsApplicationToInvoices>
    <enableTrxnAmountsStorageInCorpCurrency>true</enableTrxnAmountsStorageInCorpCurrency>
</BillingSettings>
