<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Fail closed: a line edited after the last reprice carries a stale stored approval level, so require every approval tier.</description>
        <name>Require_Full_Approval</name>
        <label>Require Full Approval</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>PricingStale</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>DiscountApprovalLevel</assignToReference>
            <operator>Assign</operator>
            <value>
                <numberValue>3.0</numberValue>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Is_Pricing_Stale</name>
        <label>Is Pricing Stale</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Current</defaultConnectorLabel>
        <rules>
            <name>Stale</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Line_Changed_After_Pricing</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Require_Full_Approval</targetReference>
            </connector>
            <label>Stale</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <description>The last reprice time, or a time before any record when the quote was never priced (so any line counts as changed after pricing).</description>
        <name>PricedAfter</name>
        <dataType>DateTime</dataType>
        <expression>BLANKVALUE({!QuoteLastPricedDate}, DATETIMEVALUE(&quot;1900-01-01 00:00:00&quot;))</expression>
    </formulas>
    <interviewLabel>RLM Quote Approval Data {!$Flow.CurrentDateTime}</interviewLabel>
    <label>RLM Quote Approval Data</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Quote_Data</name>
        <label>Get Quote Data</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Line_Changed_After_Pricing</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>QuoteId</elementReference>
            </value>
        </filters>
        <object>Quote</object>
        <outputAssignments>
            <assignToReference>QuoteId</assignToReference>
            <field>Id</field>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>OriginalActionType</assignToReference>
            <field>OriginalActionType</field>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>DiscountApprovalLevel</assignToReference>
            <field>RLM_Approval_Level__c</field>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>PaymentTerms</assignToReference>
            <field>RLM_Payment_Terms__c</field>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>QuoteLastPricedDate</assignToReference>
            <field>LastPricedDate</field>
        </outputAssignments>
    </recordLookups>
    <recordLookups>
        <description>The stored line approval levels are written by the pricing procedure, so a line modified after the last reprice (e.g. a Discount edited through the API) has a stale level.</description>
        <name>Get_Line_Changed_After_Pricing</name>
        <label>Get Line Changed After Pricing</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Is_Pricing_Stale</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>QuoteId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>QuoteId</elementReference>
            </value>
        </filters>
        <filters>
            <field>LastModifiedDate</field>
            <operator>GreaterThan</operator>
            <value>
                <elementReference>PricedAfter</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>QuoteLineItem</object>
        <queriedFields>Id</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Quote_Data</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>DiscountApprovalLevel</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <scale>0</scale>
        <value>
            <numberValue>0.0</numberValue>
        </value>
    </variables>
    <variables>
        <name>OriginalActionType</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>PaymentTerms</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <description>True when a quote line changed after the last reprice; the stored approval level is then stale and DiscountApprovalLevel is forced to 3.</description>
        <name>PricingStale</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <value>
            <booleanValue>false</booleanValue>
        </value>
    </variables>
    <variables>
        <name>QuoteId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>QuoteLastPricedDate</name>
        <dataType>DateTime</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
