<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>The Commerce tables, as listed on the first screen and in dt_commerce_decision_tables.</description>
        <name>Set_Commerce_Table_Names</name>
        <label>Set Commerce Table Names</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>decisionTableApiNames</assignToReference>
            <operator>Add</operator>
            <value>
                <stringValue>Price_Book_Entry_Commerce_V2</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>decisionTableApiNames</assignToReference>
            <operator>Add</operator>
            <value>
                <stringValue>Price_Book_Entry_For_Unit_Price_Commerce_V1</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>decisionTableApiNames</assignToReference>
            <operator>Add</operator>
            <value>
                <stringValue>Pricebook_Entry_Adjustment_Commerce_V1</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>decisionTableApiNames</assignToReference>
            <operator>Add</operator>
            <value>
                <stringValue>Range_Based_Adjustments_Commerce_V1</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>decisionTableApiNames</assignToReference>
            <operator>Add</operator>
            <value>
                <stringValue>Slab_Based_Adjustments_Commerce_V1</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Refresh_Tables</targetReference>
        </connector>
    </assignments>
    <customProperties>
        <name>ScreenProgressIndicator</name>
        <value>
            <stringValue>{&quot;location&quot;:&quot;top&quot;,&quot;type&quot;:&quot;simple&quot;}</stringValue>
        </value>
    </customProperties>
    <description>Screen flow to refresh Commerce decision tables. Aligns with CCI dt_commerce_decision_tables. Run when Commerce is enabled. The refresh is RLM_Refresh_Decision_Tables_Bulk, so a table whose refresh throws is counted and named on the result screen rather than ending the flow with the tables after it unrefreshed. Deploy unpackaged/post_utils first (deploy_post_utils), which ships that flow.</description>
    <environments>Default</environments>
    <interviewLabel>RLM Refresh Commerce Decision Tables {!$Flow.CurrentDateTime}</interviewLabel>
    <label>RLM Refresh Commerce Decision Tables</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <screens>
        <name>Refresh_Commerce_Decision_Tables</name>
        <label>Refresh Commerce Decision Tables</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Set_Commerce_Table_Names</targetReference>
        </connector>
        <fields>
            <name>Refresh_Commerce_Header</name>
            <fieldText>&lt;p&gt;&lt;strong&gt;Refresh Commerce Decision Tables&lt;/strong&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>txtCommerceDTs</name>
            <fieldText>&lt;p&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;This will refresh the following Commerce decision tables.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;span style=&quot;font-size: 10px; background-color: rgb(255, 255, 255); color: rgb(0, 0, 0);&quot;&gt;Price_Book_Entry_Commerce_V2&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-size: 10px; background-color: rgb(255, 255, 255); color: rgb(0, 0, 0);&quot;&gt;Price_Book_Entry_For_Unit_Price_Commerce_V1&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-size: 10px; background-color: rgb(255, 255, 255); color: rgb(0, 0, 0);&quot;&gt;Pricebook_Entry_Adjustment_Commerce_V1&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-size: 10px; background-color: rgb(255, 255, 255); color: rgb(0, 0, 0);&quot;&gt;Range_Based_Adjustments_Commerce_V1&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-size: 10px; background-color: rgb(255, 255, 255); color: rgb(0, 0, 0);&quot;&gt;Slab_Based_Adjustments_Commerce_V1&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <nextOrFinishButtonLabel>Refresh</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <screens>
        <name>Refresh_Result</name>
        <label>Refresh Result</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Result_Counts</name>
            <fieldText>&lt;p&gt;&lt;strong&gt;{!Refresh_Tables.queuedCount} Commerce decision tables queued for refresh, {!Refresh_Tables.failedCount} failed.&lt;/strong&gt; A queued refresh finishes in the background; the Decision Table Manager shows its status.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>Result_Failed</name>
            <fieldText>&lt;p&gt;Failed: {!Refresh_Tables.failedApiNames}. A table that is missing or inactive in this org cannot be refreshed, and a refresh queues only for a user with both Modify All Data and Customize Application. If you lack those permissions, ask an admin to refresh these from the Decision Table Manager.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <visibilityRule>
                <conditionLogic>and</conditionLogic>
                <conditions>
                    <leftValueReference>Refresh_Tables.failedCount</leftValueReference>
                    <operator>GreaterThan</operator>
                    <rightValue>
                        <numberValue>0.0</numberValue>
                    </rightValue>
                </conditions>
            </visibilityRule>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Refresh_Commerce_Decision_Tables</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <subflows>
        <name>Refresh_Tables</name>
        <label>Refresh Tables</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Refresh_Result</targetReference>
        </connector>
        <flowName>RLM_Refresh_Decision_Tables_Bulk</flowName>
        <inputAssignments>
            <name>decisionTableApiNames</name>
            <value>
                <elementReference>decisionTableApiNames</elementReference>
            </value>
        </inputAssignments>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </subflows>
    <variables>
        <name>decisionTableApiNames</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
