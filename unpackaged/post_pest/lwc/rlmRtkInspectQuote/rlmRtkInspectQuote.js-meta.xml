<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Rentokil Inspect &amp; Quote</masterLabel>
    <description>Visual field tablet Inspect &amp; Quote for residential pest plans</description>
    <targets>
        <target>lightning__FlowScreen</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__FlowScreen">
            <property name="accountName" type="String" label="Account Name" role="inputOnly"/>
            <property name="postalCode" type="String" label="Service ZIP" role="inputOnly"/>
            <property name="recommendationJson" type="String" label="Inspection Recommendation JSON" role="inputOnly"/>
            <property name="planSku" type="String" label="Plan SKU"/>
            <property name="propertyType" type="String" label="Property Type"/>
            <property name="squareFootage" type="String" label="Square Footage Bucket"/>
            <property name="severity" type="String" label="Severity"/>
            <property name="includeMosquito" type="Boolean" label="Include Mosquito"/>
            <property name="includeTermite" type="Boolean" label="Include Termite"/>
            <property name="overrideReason" type="String" label="Override Reason" role="outputOnly"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
