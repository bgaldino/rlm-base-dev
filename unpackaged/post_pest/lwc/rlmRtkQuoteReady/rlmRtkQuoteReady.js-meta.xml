<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Rentokil Quote Ready</masterLabel>
    <description>Success panel after Inspect &amp; Quote creates a priced Quote</description>
    <targets>
        <target>lightning__FlowScreen</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__FlowScreen">
            <property name="accountName" type="String" label="Account Name" role="inputOnly"/>
            <property name="quoteId" type="String" label="Quote Id" role="inputOnly"/>
            <property name="zoneCode" type="String" label="Zone Code" role="inputOnly"/>
            <property name="zoneMultiplier" type="String" label="Zone Multiplier" role="inputOnly"/>
            <property name="message" type="String" label="Message" role="inputOnly"/>
            <property name="success" type="Boolean" label="Success" role="inputOnly"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
