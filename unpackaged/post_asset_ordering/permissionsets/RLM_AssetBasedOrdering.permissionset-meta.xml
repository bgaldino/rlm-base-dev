<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <!--
      Asset-Based Ordering Console feature permission set.

      Scope: exactly what the feature's Apex touches, built from the code.
      The console Apex is READ-ONLY (WITH USER_MODE SOQL) - it never DMLs
      Quote/Order/Asset. The actual lifecycle mutations are performed by the
      NATIVE standard invocable actions (initiateAmendment / initiateRenewal /
      initiateCancellation), which execute under the running user's standard
      Revenue Cloud permissions. Therefore this set grants only object READ +
      FLS READ for the objects/fields the console queries. The running user must
      ALSO hold the standard RLM sales / asset-lifecycle permissions (from the
      RLM persona permission set group) to execute the native actions and create
      the output Quote/Order - that is an intentional dependency, not duplicated
      here, to keep this set least-privilege.

      FLS is granted only for permissionable=true fields the code reads (verified
      via describe). Non-permissionable fields (Name, RootAssetId, ParentId,
      Contract.*, AssetStatePeriod.*, AssetContractRelationship.AssetId/ContractId/
      StartDate) are governed by the object read grants below.
    -->
    <classAccesses>
        <apexClass>RLM_AssetConsoleController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>RLM_AssetOrderingService</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>RLM_AccountAssetPortfolioService</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>RLM_AssetConfiguratorService</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>RLM_AssetSuspensionService</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>RLM_ShipmentFulfillmentService</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <!-- Phase 4: auto born-held gate (Asset + BillingScheduleGroup triggers).
             Trigger DML/queries run in system mode; the billing group override is
             engine-owned data touched only in system mode, so no BillingScheduleGroup
             object/FLS grant is needed here. -->
        <apexClass>RLM_AssetBillingHoldHandler</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <pageAccesses>
        <apexPage>RLM_SessionId</apexPage>
        <enabled>true</enabled>
    </pageAccesses>

    <!-- Object reads -->
    <objectPermissions>
        <!-- Edit is required for the Phase 3 suspend/resume "as user" DML that
             stamps RLM_Asset_Status__c / RLM_Suspension_Resume_Date__c. The
             Phase 1 lifecycle mutations are done by the native actions, not here. -->
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Asset</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>AssetStatePeriod</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>AssetContractRelationship</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Contract</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Account</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <!-- Platform dependency: Account read requires Contact read. -->
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Contact</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Product2</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <!-- Phase 4: canonical serialized-product records. Create/Edit for the
             shipment-confirmation event (RLM_ShipmentFulfillmentService.confirmShipment
             maps serials to the shipped hardware, "as user"); Read for the console
             serial-unit column. SerializedProduct fields are non-permissionable, so
             access is governed by these object grants (no FLS entries). -->
        <allowCreate>true</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>SerializedProduct</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <!-- Phase 4: selling-model classification (one-time hardware vs
             subscription software) for the bundle-billing gate. Read only;
             SellingModelType / Product2Id are non-permissionable (object-governed). -->
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>ProductSellingModelOption</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>ProductSellingModel</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>

    <!-- FLS read for permissionable fields the console queries -->
    <fieldPermissions>
        <editable>false</editable>
        <field>Asset.Quantity</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Asset.CurrentQuantity</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Asset.CurrentMrr</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Asset.CurrentAmount</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <!-- Editable: confirmShipment mirrors the first serial onto the hardware. -->
        <editable>true</editable>
        <field>Asset.SerialNumber</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <!-- Editable: confirmShipment sets the native lifecycle Status to Shipped. -->
        <editable>true</editable>
        <field>Asset.Status</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Asset.StatusReason</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Asset.LifecycleEndDate</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Asset.HasLifecycleManagement</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Asset.Product2Id</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Asset.AccountId</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <!-- Read for the account-hierarchy traversal (walks Account.ParentId to
             gather related accounts when "Include related accounts" is on). -->
        <editable>false</editable>
        <field>Account.ParentId</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>AssetContractRelationship.EndDate</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Product2.ProductCode</field>
        <readable>true</readable>
    </fieldPermissions>
    <!-- Phase 3 custom suspend/resume fields (read + edit; written via "as user" DML). -->
    <fieldPermissions>
        <editable>true</editable>
        <field>Asset.RLM_Asset_Status__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Asset.RLM_Suspension_Resume_Date__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <!-- Phase 4: shipment-gated billing start (written "as user" on the shipment event). -->
    <fieldPermissions>
        <editable>true</editable>
        <field>Asset.RLM_Billing_Start_Date__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <!-- Phase 4: serial-to-asset link (custom lookup; standard AssetId unusable in
         this edition). Editable: confirmShipment sets it on insert "as user".
         Readable: the console counts serialized units per asset by this lookup. -->
    <fieldPermissions>
        <editable>true</editable>
        <field>SerializedProduct.RLM_Asset__c</field>
        <readable>true</readable>
    </fieldPermissions>

    <hasActivationRequired>false</hasActivationRequired>
    <label>RLM Asset-Based Ordering</label>
</PermissionSet>
