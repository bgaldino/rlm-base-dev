<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>When a Work Order created from DRO Field Installation is Completed, mark the linked FulfillmentStep Completed and accomplish the order&apos;s Installation Complete billing milestones so milestone-billed lines become ready for invoicing, then post the order&apos;s invoice.</description>
    <environments>Default</environments>
    <interviewLabel>RLM FSL Complete Fulfillment Step {!$Flow.CurrentDateTime}</interviewLabel>
    <label>RLM FSL Complete Fulfillment Step</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <!--
      Metadata API note:
      Record-triggered flows use processType=AutoLaunchedFlow plus start.triggerType
      (for example, RecordAfterSave). RecordTriggeredFlow is not a valid FlowProcessType.
    -->
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Has_Linked_Fulfillment_Step</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Status</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Completed</stringValue>
            </value>
        </filters>
        <filters>
            <field>RLM_Fulfillment_Step__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>WorkOrder</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <actionCalls>
        <name>Invoice_Order</name>
        <label>Invoice Order</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>RLM_FSL_InvoiceOrder</actionName>
        <actionType>apex</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>orderIds</name>
            <value>
                <elementReference>$Record.RLM_Order__c</elementReference>
            </value>
        </inputParameters>
    </actionCalls>
    <assignments>
        <name>Add_Plan_Id</name>
        <label>Add Plan Id</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>planIds</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Plans.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Plans</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Add_Schedule_Id</name>
        <label>Add Schedule Id</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>scheduleIds</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Schedules.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Schedules</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Mark_Accomplished</name>
        <label>Mark Accomplished</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>Loop_Milestones.IsMilestoneAccomplished</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>milestonesToUpdate</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Milestones</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Milestones</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Has_Waiting_Schedules</name>
        <label>Has Waiting Schedules</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>None</defaultConnectorLabel>
        <rules>
            <name>Schedules_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Waiting_Schedules</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_Schedules</targetReference>
            </connector>
            <label>Schedules Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Has_Linked_Fulfillment_Step</name>
        <label>Has Linked Fulfillment Step</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Skip</defaultConnectorLabel>
        <rules>
            <name>Complete_Step</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RLM_Fulfillment_Step__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Complete_Fulfillment_Step</targetReference>
            </connector>
            <label>Complete Step</label>
        </rules>
    </decisions>
    <recordUpdates>
        <name>Complete_Fulfillment_Step</name>
        <label>Complete Fulfillment Step</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Waiting_Schedules</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.RLM_Fulfillment_Step__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>State</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Completed</stringValue>
            </value>
        </filters>
        <inputAssignments>
            <field>State</field>
            <value>
                <stringValue>Completed</stringValue>
            </value>
        </inputAssignments>
        <object>FulfillmentStep</object>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Milestones</name>
        <label>Update Milestones</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Invoice_Order</targetReference>
        </connector>
        <inputReference>milestonesToUpdate</inputReference>
    </recordUpdates>
    <recordLookups>
        <name>Get_Milestone_Plans</name>
        <label>Get Milestone Plans</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Plans</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ReferenceItemId</field>
            <operator>In</operator>
            <value>
                <elementReference>scheduleIds</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>BillingMilestonePlan</object>
        <queriedFields>Id</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Open_Milestones</name>
        <label>Get Open Milestones</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Milestones</targetReference>
        </connector>
        <filterLogic>1 AND (2 OR 3) AND 4</filterLogic>
        <filters>
            <field>BillingMilestonePlanId</field>
            <operator>In</operator>
            <value>
                <elementReference>planIds</elementReference>
            </value>
        </filters>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Installation Complete</stringValue>
            </value>
        </filters>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Initial Treatment Complete</stringValue>
            </value>
        </filters>
        <filters>
            <field>IsMilestoneAccomplished</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>BillingMilestonePlanItem</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>IsMilestoneAccomplished</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Waiting_Schedules</name>
        <label>Get Waiting Schedules</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Has_Waiting_Schedules</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ReferenceEntityId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.RLM_Order__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>WaitingForMilestoneEventAccomplishment</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>BillingSchedule</object>
        <queriedFields>Id</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <loops>
        <name>Loop_Milestones</name>
        <label>Loop Milestones</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Open_Milestones</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Mark_Accomplished</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Update_Milestones</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>Loop_Plans</name>
        <label>Loop Plans</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Milestone_Plans</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Add_Plan_Id</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Get_Open_Milestones</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>Loop_Schedules</name>
        <label>Loop Schedules</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Waiting_Schedules</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Add_Schedule_Id</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Get_Milestone_Plans</targetReference>
        </noMoreValuesConnector>
    </loops>
    <variables>
        <name>milestonesToUpdate</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>BillingMilestonePlanItem</objectType>
    </variables>
    <variables>
        <name>planIds</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>scheduleIds</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
