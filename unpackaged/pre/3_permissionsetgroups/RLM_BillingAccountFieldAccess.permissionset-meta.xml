<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Read/edit on the Billing Account fields the standard Billing permission sets omit (Shipping Address, Bill Day of Month, Payment Term) or make read-only (Bill To Contact). Without it fresh orgs hide them from the form.</description>
    <fieldPermissions>
        <editable>true</editable>
        <field>BillingAccount.BillDayOfMonth</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>BillingAccount.BillToContactId</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>BillingAccount.PaymentTermId</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>BillingAccount.ShippingAddress</field>
        <readable>true</readable>
    </fieldPermissions>
    <hasActivationRequired>false</hasActivationRequired>
    <label>RLM Billing Account Field Access</label>
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>BillingAccount</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
</PermissionSet>
