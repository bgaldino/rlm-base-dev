<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <!-- Apply a payment to an invoice at Line Level (Billing Settings > Credit, Payment, and
         Refund Application; deploy_pre's pre/2_settings and post_billing both set it, so every
         build is at Line Level). applyPayment then takes an invoice line, not the invoice
         ("Specify an InvoiceLineId as the appliedToId because the Credit Application Level is
         Invoice Line"), so this spreads the payment over the invoice's lines that still have a
         balance, in record Id order (Ids increase within an org), up to the smaller of the payment's and the invoice's
         balance. It doesn't try the invoice first: a handled fault still sends the flow error
         email. At Header Level the platform's error comes back in errorMessage.
         Outputs appliedAmount; unappliedAmount, what was left when the lines ran out of balance;
         and errorMessage when nothing could be applied or a step failed. A fault on a line sets
         lineFailed; earlier lines stay applied unless the caller rolls back (autolaunched flows
         can't). RLM_Apply_Payments_on_Invoice does, so a failed run there applies nothing.
         Only a Posted invoice, and a Processed payment on the invoice's billing account, are
         applied to; direct callers (REST) get errorMessage otherwise.
         Limit: one applyPayment per line in one transaction, so an invoice with well over a
         hundred open lines can hit flow element or governor limits; apply those with the
         payment apply API instead.
         Called by RLM_Apply_Payments_on_Invoice; autolaunched so it can be run and verified
         without the screen (REST: /services/data/vXX.X/actions/custom/flow/RLM_Apply_Payment_To_Invoice_Lines). -->
    <actionCalls>
        <name>applyToLine</name>
        <label>Apply to Line</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>applyPayment</actionName>
        <actionType>applyPayment</actionType>
        <connector>
            <targetReference>reduceRemaining</targetReference>
        </connector>
        <faultConnector>
            <targetReference>recordLineFault</targetReference>
        </faultConnector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>amount</name>
            <value>
                <elementReference>lineAmount</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>appliedToId</name>
            <value>
                <elementReference>eachLine.Id</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>paymentId</name>
            <value>
                <elementReference>paymentId</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>associatedAccountId</name>
            <value>
                <elementReference>getInvoice.BillingAccountId</elementReference>
            </value>
        </inputParameters>
        <nameSegment>applyPayment</nameSegment>
        <offset>0</offset>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <apiVersion>68.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>recordUnapplied</name>
        <label>Record Unapplied</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>unappliedAmount</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>unappliedRounded</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>anythingApplied</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>recordNoOpenLines</name>
        <label>Record No Open Lines</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>errorMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Nothing applied: no line of this invoice has a balance left.</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>recordLineFault</name>
        <label>Record Line Fault</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>errorMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>lineFailed</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>recordNotPosted</name>
        <label>Record Not Posted</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>errorMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Only a posted invoice can take a payment, and only a processed payment on the invoice&apos;s billing account can be applied.</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>recordFault</name>
        <label>Record Fault</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>errorMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>recordNotFound</name>
        <label>Record Not Found</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>errorMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>The invoice or the payment wasn&apos;t found.</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>recordNothingToApply</name>
        <label>Record Nothing To Apply</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>errorMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Nothing to apply: the payment or the invoice has no balance left.</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>reduceRemaining</name>
        <label>Reduce Remaining</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>appliedAmount</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>lineAmount</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>remaining</assignToReference>
            <operator>Subtract</operator>
            <value>
                <elementReference>lineAmount</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>stillRemaining</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>setRemaining</name>
        <label>Set Remaining</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>remaining</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>startingAmount</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>anythingToApply</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>anythingApplied</name>
        <label>Anything Applied?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Yes</defaultConnectorLabel>
        <rules>
            <name>nothingApplied</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>appliedAmount</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>recordNoOpenLines</targetReference>
            </connector>
            <label>Nothing Applied</label>
        </rules>
    </decisions>
    <decisions>
        <name>anythingLeft</name>
        <label>Anything Left?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>eachLine</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>yesApply</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>lineAmount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>applyToLine</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>anythingToApply</name>
        <label>Anything To Apply?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>recordNothingToApply</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>positiveAmount</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>startingAmount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>getLines</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>isPosted</name>
        <label>Posted Invoice and Usable Payment?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>recordNotPosted</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>posted</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>getInvoice.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Posted</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>getPayment.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Processed</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>getPayment.AccountId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>getInvoice.BillingAccountId</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>setRemaining</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>recordsFound</name>
        <label>Records Found?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>recordNotFound</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>bothFound</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>getInvoice.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>getPayment.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>isPosted</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <!-- Stop walking the lines once the payment is used up. -->
        <name>stillRemaining</name>
        <label>Still Remaining?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>recordUnapplied</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>moreToApply</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>unappliedRounded</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>eachLine</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>lineAmount</name>
        <dataType>Number</dataType>
        <expression>ROUND(MIN(BLANKVALUE({!eachLine.Balance}, 0), {!remaining}), 2)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>unappliedRounded</name>
        <dataType>Number</dataType>
        <expression>ROUND({!remaining}, 2)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>startingAmount</name>
        <dataType>Number</dataType>
        <expression>MIN(BLANKVALUE({!getPayment.Balance}, 0), BLANKVALUE({!getInvoice.Balance}, 0))</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>RLM Apply Payment To Invoice Lines {!$Flow.CurrentDateTime}</interviewLabel>
    <label>RLM Apply Payment To Invoice Lines</label>
    <loops>
        <name>eachLine</name>
        <label>Each Line</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>getLines</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>anythingLeft</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>recordUnapplied</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>getInvoice</name>
        <label>Get Invoice</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>getPayment</targetReference>
        </connector>
        <faultConnector>
            <targetReference>recordFault</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>invoiceId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Invoice</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>getLines</name>
        <label>Get Lines With a Balance</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>eachLine</targetReference>
        </connector>
        <faultConnector>
            <targetReference>recordFault</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>InvoiceId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>invoiceId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Balance</field>
            <operator>GreaterThan</operator>
            <value>
                <numberValue>0.0</numberValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>InvoiceLine</object>
        <sortField>Id</sortField>
        <sortOrder>Asc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>getPayment</name>
        <label>Get Payment</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>recordsFound</targetReference>
        </connector>
        <faultConnector>
            <targetReference>recordFault</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>paymentId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Payment</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>getInvoice</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>appliedAmount</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <scale>2</scale>
        <value>
            <numberValue>0.0</numberValue>
        </value>
    </variables>
    <variables>
        <name>errorMessage</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>invoiceId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>lineFailed</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <value>
            <booleanValue>false</booleanValue>
        </value>
    </variables>
    <variables>
        <name>paymentId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>unappliedAmount</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <scale>2</scale>
        <value>
            <numberValue>0.0</numberValue>
        </value>
    </variables>
    <variables>
        <name>remaining</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>2</scale>
    </variables>
</Flow>
