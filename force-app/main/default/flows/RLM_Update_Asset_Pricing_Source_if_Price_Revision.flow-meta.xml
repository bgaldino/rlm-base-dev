<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Defaults a lifecycle-managed asset with no pricing source to Last Transaction, so amendments, as-is renewals and price revision use the price it was sold at. An asset whose pricing source is already set (for example Price Book List Price, chosen to price added quantity at today&apos;s list) is never changed. Previously named "Update Asset Pricing Source if Price Revision": its price-revision-policy check looked for an order item whose RelatedOrderItemId pointed at the asset&apos;s source line, which almost never exists, so every blank asset was stamped anyway (todo 181).</description>
    <environments>Default</environments>
    <interviewLabel>RLM Default Asset Pricing Source to Last Transaction {!$Flow.CurrentDateTime}</interviewLabel>
    <label>RLM Default Asset Pricing Source to Last Transaction</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Set_Pricing_Source_to_Last_Transaction</name>
        <label>Set Pricing Source to Last Transaction</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>PricingSource</field>
            <value>
                <stringValue>LastTransaction</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Set_Pricing_Source_to_Last_Transaction</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>HasLifecycleManagement</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>PricingSource</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Asset</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
