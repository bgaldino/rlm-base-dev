    <assignments>
        <name>Set_Currency_From_Asset</name>
        <label>Set Currency From Asset</label>
        <locationX>176</locationX>
        <locationY>350</locationY>
        <assignmentItems>
            <assignToReference>$Record.CurrencyIsoCode</assignToReference>
            <operator>Assign</operator>
