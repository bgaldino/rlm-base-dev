    <decisions>
        <name>Currency_Differs_From_Asset</name>
        <label>Currency Differs From Asset</label>
        <locationX>176</locationX>
        <locationY>242</locationY>
        <defaultConnectorLabel>No Change</defaultConnectorLabel>
        <rules>
            <name>Differs</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.CurrencyIsoCode</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Asset.CurrencyIsoCode</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Currency_From_Asset</targetReference>
            </connector>
            <label>Differs</label>
        </rules>
    </decisions>
    <description>Before-save: stamps a new AssetRateCardEntry's CurrencyIsoCode with its parent Asset's currency. The platform defaults this restricted picklist to USD and does not inherit the asset currency at entitlement creation (Salesforce 262, no config remedy), leaving non-USD assets' usage rate entries stamped USD. Data-integrity fix for the read-only Usage Rates tab and any currency-keyed custom logic; does not change invoiced amounts (usage billing denominates in the account currency).</description>
    <environments>Default</environments>
    <interviewLabel>RLM Default Asset Rate Card Currency {!$Flow.CurrentDateTime}</interviewLabel>
    <label>RLM Default Asset Rate Card Currency</label>
