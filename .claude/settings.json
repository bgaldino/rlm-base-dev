{
  "permissions": {
    "deny": [
      "Edit(unpackaged/post_ux/**)",
      "Bash(git push origin main)",
      "Bash(git push origin main *)",
      "Bash(git push origin preview/*)",
      "Bash(git push origin release/*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pre_tool_guard.py",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop_gate.py",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
